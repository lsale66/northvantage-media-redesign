---
/**
 * Rule-of-thirds framing guides — the quiet half of the viewfinder motif.
 * Hairlines draw themselves in on scroll.
 */
interface Props {
  class?: string;
  ink?: string;
}
const { class: className = '', ink = 'rgba(236,239,243,0.07)' } = Astro.props;
---

<div class={`pointer-events-none absolute inset-0 overflow-hidden ${className}`} aria-hidden="true">
  <span
    class="absolute top-0 bottom-0 left-1/3 w-px origin-top"
    style={`background:${ink}`}
    data-reveal="drawy"
  ></span>
  <span
    class="absolute top-0 bottom-0 left-2/3 w-px origin-bottom"
    style={`background:${ink};--i:2`}
    data-reveal="drawy"
  ></span>
  <span
    class="absolute left-0 right-0 top-1/3 h-px origin-left"
    style={`background:${ink};--i:1`}
    data-reveal="drawx"
  ></span>
  <span
    class="absolute left-0 right-0 top-2/3 h-px origin-right"
    style={`background:${ink};--i:3`}
    data-reveal="drawx"
  ></span>
</div>
