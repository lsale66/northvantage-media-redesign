---
/* Two source photographs, cropped and graded into a contact sheet of frames —
   the zoom factor is what makes each tile read as a separate exposure. */
const columnA = [
  { src: '/images/redesign/image-03.jpg', pos: '50% 62%', z: 1,    ratio: '4 / 5', code: 'NV·0341', cap: 'Elbow Park · Twilight',    grade: 'saturate(1.04) contrast(1.03)' },
  { src: '/images/redesign/image-02.jpg', pos: '64% 42%', z: 1,    ratio: '1 / 1', code: 'NV·0338', cap: 'Bow River · Aerial',       grade: 'saturate(0.78) contrast(1.1) brightness(0.82)' },
  { src: '/images/redesign/image-03.jpg', pos: '22% 44%', z: 2.4,  ratio: '3 / 4', code: 'NV·0327', cap: 'Aspen Woods · Facade',     grade: 'saturate(0.96) contrast(1.08)' },
  { src: '/images/redesign/image-02.jpg', pos: '20% 62%', z: 2.2,  ratio: '4 / 5', code: 'NV·0312', cap: 'Beltline · Approach',      grade: 'saturate(0.72) contrast(1.12) brightness(0.78)' },
  { src: '/images/redesign/image-03.jpg', pos: '84% 26%', z: 2,    ratio: '1 / 1', code: 'NV·0305', cap: 'Springbank Hill · Dusk',   grade: 'saturate(1.12) contrast(1.02)' },
];

const columnB = [
  { src: '/images/redesign/image-02.jpg', pos: '46% 24%', z: 1.9,  ratio: '3 / 4', code: 'NV·0336', cap: 'Downtown · Drone',         grade: 'saturate(0.74) contrast(1.1) brightness(0.8)' },
  { src: '/images/redesign/image-03.jpg', pos: '36% 86%', z: 3,    ratio: '1 / 1', code: 'NV·0329', cap: 'Discovery Ridge · Detail', grade: 'saturate(1.02) brightness(1.02)' },
  { src: '/images/redesign/image-03.jpg', pos: '62% 20%', z: 2.2,  ratio: '4 / 5', code: 'NV·0318', cap: 'Cochrane · Blue Hour',     grade: 'saturate(1.14) contrast(1.05) brightness(0.96)' },
  { src: '/images/redesign/image-02.jpg', pos: '86% 58%', z: 2.6,  ratio: '1 / 1', code: 'NV·0309', cap: 'Bridgeland · Streetscape', grade: 'saturate(0.7) contrast(1.08) brightness(0.76)' },
  { src: '/images/redesign/image-03.jpg', pos: '6% 38%',  z: 1.7,  ratio: '3 / 4', code: 'NV·0296', cap: 'Okotoks · Exterior',       grade: 'saturate(0.98) contrast(1.07)' },
];
---

<section class="relative overflow-hidden bg-brand-bg">
  <!-- Ambient vantage glow -->
  <div
    class="pointer-events-none absolute -top-40 left-[-10%] h-[720px] w-[720px] rounded-full opacity-70 blur-[120px]"
    style="background: radial-gradient(circle, rgba(33,50,77,0.75) 0%, rgba(12,16,21,0) 68%)"
    aria-hidden="true"
  ></div>
  <div
    class="pointer-events-none absolute bottom-[-18%] left-[8%] h-[420px] w-[420px] rounded-full opacity-40 blur-[130px]"
    style="background: radial-gradient(circle, rgba(255,106,44,0.34) 0%, rgba(12,16,21,0) 70%)"
    aria-hidden="true"
  ></div>

  <div class="relative mx-auto grid w-full max-w-[1500px] items-stretch lg:min-h-screen lg:grid-cols-[1.04fr_0.96fr]">
    <!-- ── Left: the argument ───────────────────────────────── -->
    <div class="relative flex flex-col justify-center px-5 pb-14 pt-32 sm:px-8 lg:py-40 lg:pl-12 lg:pr-16">
      <!-- Left gutter framing rail -->
      <div class="pointer-events-none absolute bottom-24 left-0 top-40 hidden w-4 lg:block" aria-hidden="true">
        <span class="absolute left-0 top-0 h-3.5 w-3.5 border-l-[1.5px] border-t-[1.5px] border-brand-accent"></span>
        <span class="absolute bottom-0 left-0 top-6 w-px bg-gradient-to-b from-brand-text/25 to-transparent"></span>
        <span class="absolute bottom-0 left-0 h-3.5 w-3.5 border-b-[1.5px] border-l-[1.5px] border-brand-text/25"></span>
      </div>

      <p class="eyebrow enter" style="--i:0">Calgary · Listing Media · Est. 2023</p>

      <h1 class="display display-hero enter mt-7 text-brand-text" style="--i:1">
        Every listing has<br />a better<br /><em class="text-brand-accent">vantage point.</em>
      </h1>

      <p class="lede enter mt-8" style="--i:2">
        Photography, cinematic video, iGuide 3D tours and drone work for Calgary
        agents selling homes that deserve more than a phone-camera walkthrough.
      </p>

      <div class="enter mt-10 flex flex-col gap-3 sm:flex-row sm:items-center" style="--i:3">
        <a href="/contact" class="pill pill-accent">
          Call or Text
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M1 7h11M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href="/book" class="pill pill-outline">Book Online</a>
      </div>

      <!-- Proof strip -->
      <div class="enter mt-12 flex flex-wrap items-center gap-x-6 gap-y-4" style="--i:4">
        <span class="flex items-center gap-2.5">
          <img src="/images/redesign/image-01.png" alt="" class="h-4 w-4" width="16" height="16" aria-hidden="true" />
          <span class="meta text-[10px] text-brand-text/85">5.0 on Google</span>
        </span>
        <span class="h-4 w-px bg-brand-text/15"></span>
        <span class="meta text-[10px] text-brand-muted">335+ Homes Shot</span>
        <span class="h-4 w-px bg-brand-text/15"></span>
        <span class="meta text-[10px] text-brand-muted">Next-Morning Delivery</span>
      </div>
    </div>

    <!-- ── Right: the contact sheet ─────────────────────────── -->
    <div class="relative h-[440px] sm:h-[540px] lg:h-auto">
      <div class="absolute inset-0 overflow-hidden">
        <div class="sheet-mask absolute inset-0 grid grid-cols-2 gap-3 px-4 sm:gap-4 sm:px-5 lg:gap-5 lg:px-6">
          <!-- Column A -->
          <div class="vp-track track-up flex flex-col gap-3 sm:gap-4 lg:gap-5">
            {[...columnA, ...columnA].map((t, i) => (
              <figure class="tile vp-corners vp-grow" style={`--vp-inset:9px;--vp-arm:12px;--vp-ink:rgba(236,239,243,0.34)`}>
                <div class="tile-frame" style={`aspect-ratio:${t.ratio}`}>
                  <img
                    src={t.src}
                    alt={i < columnA.length ? `${t.cap} — Northvantage Media listing photography` : ''}
                    decoding="async"
                    aria-hidden={i >= columnA.length ? 'true' : undefined}
                    style={`object-position:${t.pos};filter:${t.grade};--z:${t.z}`}
                  />
                </div>
                <figcaption class="tile-cap">
                  <span class="meta text-[9px] text-brand-accent">{t.code}</span>
                  <span class="meta text-[9px] text-brand-text/70">{t.cap}</span>
                </figcaption>
              </figure>
            ))}
          </div>

          <!-- Column B — counter-scrolling, offset for tension -->
          <div class="vp-track track-down flex flex-col gap-3 pt-10 sm:gap-4 sm:pt-14 lg:gap-5 lg:pt-20">
            {[...columnB, ...columnB].map((t, i) => (
              <figure class="tile vp-corners vp-grow" style={`--vp-inset:9px;--vp-arm:12px;--vp-ink:rgba(236,239,243,0.34)`}>
                <div class="tile-frame" style={`aspect-ratio:${t.ratio}`}>
                  <img
                    src={t.src}
                    alt={i < columnB.length ? `${t.cap} — Northvantage Media listing photography` : ''}
                    decoding="async"
                    aria-hidden={i >= columnB.length ? 'true' : undefined}
                    style={`object-position:${t.pos};filter:${t.grade};--z:${t.z}`}
                  />
                </div>
                <figcaption class="tile-cap">
                  <span class="meta text-[9px] text-brand-accent">{t.code}</span>
                  <span class="meta text-[9px] text-brand-text/70">{t.cap}</span>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>

        <!-- Edge feather into the page -->
        <div class="pointer-events-none absolute inset-y-0 left-0 w-24 bg-gradient-to-r from-brand-bg to-transparent lg:w-32" aria-hidden="true"></div>
        <!-- Scrim so the nav stays legible over the sheet -->
        <div class="pointer-events-none absolute inset-x-0 top-0 h-28 bg-gradient-to-b from-brand-bg via-brand-bg/70 to-transparent lg:h-36" aria-hidden="true"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .tile {
    position: relative;
    flex: none;
    border-radius: 14px;
    overflow: hidden;
    background: var(--color-brand-surface);
    box-shadow: var(--print);
    transition: box-shadow 0.5s var(--ease-out-quint), transform 0.5s var(--ease-snap);
  }
  .tile:hover {
    transform: translateY(-4px) scale(1.012);
    box-shadow: var(--print-lift);
  }
  .tile-frame { width: 100%; }
  .tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: scale(var(--z, 1));
    transition: transform 1.1s var(--ease-out-quint);
  }
  .tile:hover img { transform: scale(calc(var(--z, 1) * 1.06)); }
  .tile-cap {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 1.4rem 0.85rem 0.7rem;
    background: linear-gradient(to top, rgba(12, 16, 21, 0.92), rgba(12, 16, 21, 0));
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.45s var(--ease-out-quint), transform 0.45s var(--ease-out-quint);
  }
  .tile:hover .tile-cap { opacity: 1; transform: none; }

  /* On touch, captions stay visible — no hover to discover them */
  @media (hover: none) {
    .tile-cap { opacity: 1; transform: none; }
  }

  .vp-track { will-change: transform; }
  .track-up   { animation: vp-track-up 46s linear infinite; }
  .track-down { animation: vp-track-down 54s linear infinite; }
  .vp-track:hover { animation-play-state: paused; }
</style>
