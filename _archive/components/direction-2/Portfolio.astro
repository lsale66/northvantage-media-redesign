---
const tiles = [
  {
    src: '/images/redesign/image-02.jpg',
    pos: '55% 45%',
    z: 1,
    grade: 'saturate(0.76) contrast(1.08) brightness(0.84)',
    code: 'NV·0338',
    title: 'Bow River',
    kind: 'Drone · Neighbourhood context',
    shift: '',
  },
  {
    src: '/images/redesign/image-03.jpg',
    pos: '58% 46%',
    z: 2.6,
    grade: 'saturate(1.08) contrast(1.05)',
    code: 'NV·0327',
    title: 'Aspen Woods',
    kind: 'Entry · Flash-blended',
    shift: 'lg:mt-10',
  },
  {
    src: '/images/redesign/image-03.jpg',
    pos: '30% 18%',
    z: 2.9,
    grade: 'saturate(1.14) contrast(1.02)',
    code: 'NV·0305',
    title: 'Springbank Hill',
    kind: 'Gable · Available light',
    shift: 'lg:mt-4',
  },
];
---

<section id="work" class="relative overflow-hidden bg-brand-surface pb-32 pt-24 lg:pb-48 lg:pt-32">
  <!-- Header -->
  <div class="mx-auto w-full max-w-[1500px] px-5 sm:px-8 lg:px-12">
    <div class="flex flex-wrap items-end justify-between gap-8">
      <div>
        <p class="eyebrow" data-reveal="up">Selected frames</p>
        <h2 class="h2 mt-6 max-w-[16ch] text-brand-text" data-reveal="up" style="--i:1">
          Proof beats a <strong>pitch deck.</strong>
        </h2>
      </div>
      <a href="/gallery" class="pill pill-outline pill-sm" data-reveal="up" style="--i:2">
        View the full gallery
        <svg width="12" height="12" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M1 7h11M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </div>

  <!-- Full-bleed hero frame — breaks the modular rhythm on purpose -->
  <div class="relative mt-12 lg:mt-16">
    <figure class="hero-frame" data-reveal="scale">
      <img
        src="/images/redesign/image-03.jpg"
        alt="Twilight exterior of a Calgary home photographed by Northvantage Media, warm interior lighting against a deep blue sky"
        loading="lazy"
        decoding="async"
      />
      <div class="frame-marks" aria-hidden="true"></div>
      <figcaption class="tech meta">ƒ/8 · 1/60 · ISO 200 · Blend of five exposures</figcaption>
    </figure>

    <!-- Caption plate overlaps the image edge -->
    <div class="relative z-10 mx-auto w-full max-w-[1500px] px-5 sm:px-8 lg:px-12">
      <div class="plate vp-corners" data-reveal="up" style="--vp-inset:12px;--vp-arm:14px;--vp-ink:rgba(236,239,243,0.24)">
        <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
          <span class="meta text-[10px] text-brand-accent">NV·0341</span>
          <span class="meta text-[10px] text-brand-muted">Twilight · Elbow Park</span>
        </div>
        <p class="h3 mt-4 text-brand-text">
          Shot at 9:42pm, on the sixteen minutes when the sky is still blue and the windows already glow.
        </p>
        <p class="mt-4 max-w-[52ch] text-[14px] leading-relaxed text-brand-muted">
          Twilight is the shot agents remember, and it is also the one that goes
          wrong most often. We hold the window for the whole set, so the interiors
          in the gallery match the exterior on the feature sheet.
        </p>
      </div>
    </div>
  </div>

  <!-- Staggered supporting frames -->
  <div class="mx-auto mt-16 w-full max-w-[1500px] px-5 sm:px-8 lg:mt-24 lg:px-12">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 lg:gap-7">
      {tiles.map((t, i) => (
        <a
          href="/gallery"
          class={`frame vp-corners vp-grow ${t.shift}`}
          style={`--vp-inset:12px;--vp-arm:13px;--vp-ink:rgba(236,239,243,0.26);--i:${i}`}
          data-reveal="rise"
        >
          <span class="frame-img">
            <img src={t.src} alt={`${t.title} — ${t.kind}`} loading="lazy" decoding="async" style={`object-position:${t.pos};filter:${t.grade};--z:${t.z}`} />
          </span>
          <span class="frame-meta">
            <span class="flex items-baseline justify-between gap-3">
              <span class="h3 text-brand-text">{t.title}</span>
              <span class="meta text-[9px] text-brand-accent">{t.code}</span>
            </span>
            <span class="meta mt-2 block text-[9px] text-brand-muted">{t.kind}</span>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .hero-frame {
    position: relative;
    width: 100%;
    height: clamp(340px, 62vh, 720px);
    overflow: hidden;
  }
  .hero-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 42%;
  }
  .hero-frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgba(22, 27, 34, 0.55) 0%, rgba(22, 27, 34, 0) 26%),
      linear-gradient(to top, rgba(22, 27, 34, 0.85) 0%, rgba(22, 27, 34, 0) 42%);
  }
  /* Viewfinder marks laid over the full-bleed frame */
  .frame-marks {
    position: absolute;
    inset: 1.75rem;
    z-index: 2;
    --c: rgba(236, 239, 243, 0.55);
    background:
      linear-gradient(var(--c), var(--c)) 0 0 / 28px 1.5px no-repeat,
      linear-gradient(var(--c), var(--c)) 0 0 / 1.5px 28px no-repeat,
      linear-gradient(var(--c), var(--c)) 100% 0 / 28px 1.5px no-repeat,
      linear-gradient(var(--c), var(--c)) 100% 0 / 1.5px 28px no-repeat,
      linear-gradient(var(--c), var(--c)) 0 100% / 28px 1.5px no-repeat,
      linear-gradient(var(--c), var(--c)) 0 100% / 1.5px 28px no-repeat,
      linear-gradient(var(--c), var(--c)) 100% 100% / 28px 1.5px no-repeat,
      linear-gradient(var(--c), var(--c)) 100% 100% / 1.5px 28px no-repeat;
  }
  @media (min-width: 1024px) {
    .frame-marks { inset: 2.75rem; }
  }
  .tech {
    position: absolute;
    right: 2rem;
    top: 2.5rem;
    z-index: 3;
    font-size: 9px;
    color: rgba(236, 239, 243, 0.6);
  }
  @media (min-width: 1024px) {
    .tech { right: 3.5rem; top: 3.6rem; }
  }

  .plate {
    margin-top: -3.5rem;
    max-width: 620px;
    border-radius: 22px;
    border: 1px solid rgba(236, 239, 243, 0.1);
    background: linear-gradient(160deg, #1c232c 0%, #12171d 100%);
    box-shadow: var(--print-lift);
    padding: 2rem 1.75rem;
  }
  @media (min-width: 1024px) {
    .plate { margin-top: -6rem; padding: 2.75rem 2.5rem; margin-left: 2rem; }
  }

  .frame {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 22px;
    border: 1px solid rgba(236, 239, 243, 0.08);
    background: #12171d;
    box-shadow: var(--print);
    transition: transform 0.55s var(--ease-snap), box-shadow 0.55s var(--ease-out-quint), border-color 0.4s ease;
  }
  .frame:hover {
    transform: translateY(-10px);
    box-shadow: var(--print-lift);
    border-color: rgba(255, 106, 44, 0.3);
  }
  .frame-img { display: block; overflow: hidden; aspect-ratio: 4 / 3; }
  .frame-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(var(--z, 1));
    transition: transform 1.1s var(--ease-out-quint);
  }
  .frame:hover .frame-img img { transform: scale(calc(var(--z, 1) * 1.06)); }
  .frame-meta { display: block; padding: 1.35rem 1.5rem 1.5rem; }
</style>
