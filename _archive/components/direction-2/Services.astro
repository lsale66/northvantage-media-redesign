---
const services = [
  {
    title: 'Photography',
    spec: '35–45 finished images',
    body: 'Interiors, exteriors and the detail shots most photographers skip — flash-blended and colour-matched across the whole set so the gallery reads as one shoot, not forty separate frames.',
    href: '/services#photography',
    span: 'lg:col-span-5',
    shift: '',
  },
  {
    title: 'Cinematic Video',
    spec: '60–90 seconds + social cuts',
    body: 'Gimbal-led walkthroughs cut to a licensed track, graded to match the stills. Vertical cutdowns come with it, because that is where the listing actually gets watched.',
    href: '/services#video',
    span: 'lg:col-span-7',
    shift: 'lg:mt-10',
    feature: true,
  },
  {
    title: 'iGuide 3D Tours',
    spec: 'Floor plan + sq ft report',
    body: 'A measured tour buyers can walk at midnight, with square footage you can publish without hedging. Room dimensions land in your listing sheet the same day.',
    href: '/services#iguide',
    span: 'lg:col-span-4',
    shift: '',
  },
  {
    title: 'Drone Photo + Video',
    spec: 'Transport Canada certified',
    body: 'Lot lines, roofline, ridge views and the streetscape that sells the neighbourhood before the buyer opens the front door. Flown by a licensed RPAS pilot, insured.',
    href: '/services#drone',
    span: 'lg:col-span-4',
    shift: 'lg:mt-8',
  },
  {
    title: 'Virtual Staging',
    spec: '48-hour render',
    body: 'Empty rooms furnished to suit the house rather than a catalogue, rendered from the frames we already shot so the perspective and light stay honest.',
    href: '/services#staging',
    span: 'lg:col-span-4',
    shift: 'lg:mt-16',
  },
];
---

<section id="services" class="relative bg-brand-bg px-5 pb-28 pt-24 sm:px-8 lg:px-12 lg:pb-36 lg:pt-32">
  <div class="mx-auto w-full max-w-[1500px]">
    <!-- Header: deliberately unequal columns -->
    <div class="grid gap-8 border-b border-brand-text/10 pb-12 lg:grid-cols-[1.15fr_0.85fr] lg:items-end lg:gap-16">
      <div>
        <p class="eyebrow" data-reveal="up">What we shoot</p>
        <h2 class="h2 mt-6 text-brand-text" data-reveal="up" style="--i:1">
          Five services.<br /><strong>One consistent look.</strong>
        </h2>
      </div>
      <div class="flex flex-col items-start gap-7 lg:pb-2" data-reveal="up" style="--i:2">
        <p class="lede">
          Book them as a package or one line at a time. Either way the framing,
          the grade and the delivery window stay exactly the same.
        </p>
        <a href="/services" class="pill pill-outline pill-sm">
          All five services
          <svg width="12" height="12" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M1 7h11M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Modular grid — prints laid out on a light table -->
    <div class="mt-14 grid gap-5 sm:gap-6 lg:mt-20 lg:grid-cols-12 lg:gap-7">
      {services.map((s, i) => (
        <article
          class={`card vp-corners vp-grow ${s.span} ${s.shift} ${s.feature ? 'card-feature' : ''}`}
          style={`--vp-inset:14px;--vp-arm:14px;--vp-ink:rgba(236,239,243,0.2);--i:${i}`}
          data-reveal="rise"
        >
          {s.feature ? (
            <div class="card-art" aria-hidden="true">
              <img src="/images/redesign/image-03.jpg" alt="" loading="lazy" decoding="async" />
            </div>
          ) : (
            <span class="card-ghost" aria-hidden="true"></span>
          )}
          <div class="card-body">
            <span class="spec">{s.spec}</span>
            <h3 class="h3 mt-6 text-brand-text">{s.title}</h3>
            <p class="mt-4 text-[14.5px] leading-[1.65] text-brand-muted">{s.body}</p>
            <a href={s.href} class="card-link pill pill-outline pill-sm mt-8">
              Details
              <svg width="12" height="12" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M1 7h11M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 320px;
    overflow: hidden;
    border-radius: 24px;
    border: 1px solid rgba(236, 239, 243, 0.09);
    background: linear-gradient(165deg, #1b2129 0%, var(--color-brand-surface) 55%, #10151b 100%);
    box-shadow: var(--print);
    transition:
      transform 0.55s var(--ease-snap),
      box-shadow 0.55s var(--ease-out-quint),
      border-color 0.45s var(--ease-out-quint);
  }
  .card:hover {
    transform: translateY(-10px);
    box-shadow: var(--print-lift);
    border-color: rgba(255, 106, 44, 0.32);
  }
  /* Tailwind v4 stagger uses the `translate` property, so the hover
     `transform` composes on top of it instead of fighting it. */

  @media (min-width: 1024px) {
    .card { border-radius: 28px; min-height: 380px; }
  }

  .card-body {
    position: relative;
    z-index: 2;
    padding: 2rem 1.75rem 2rem;
  }
  @media (min-width: 1024px) {
    .card-body { padding: 2.75rem 2.5rem 2.5rem; }
  }

  .card-art { position: absolute; inset: 0; z-index: 0; }
  .card-art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 55% 55%;
    transform: scale(1.04);
    transition: transform 1.2s var(--ease-out-quint);
  }
  .card-feature:hover .card-art img { transform: scale(1.1); }
  .card-art::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(12, 16, 21, 0.97) 22%, rgba(12, 16, 21, 0.72) 58%, rgba(33, 50, 77, 0.34) 100%);
  }
  .card-feature { min-height: 420px; }
  @media (min-width: 1024px) { .card-feature { min-height: 480px; } }

  .spec {
    display: inline-block;
    border-radius: 999px;
    border: 1px solid rgba(255, 106, 44, 0.34);
    background: rgba(255, 106, 44, 0.08);
    padding: 0.42rem 0.85rem;
    font-family: var(--font-body);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #ffa274;
  }

  .card-link { opacity: 0.72; transition: opacity 0.4s var(--ease-out-quint); }
  .card:hover .card-link { opacity: 1; }

  /* Oversized framing bracket occupying the card's headroom */
  .card-ghost {
    position: absolute;
    top: 2.75rem;
    right: 2rem;
    width: 96px;
    height: 96px;
    border-right: 1px solid rgba(236, 239, 243, 0.09);
    border-top: 1px solid rgba(236, 239, 243, 0.09);
    border-top-right-radius: 6px;
    transition: width 0.7s var(--ease-out-quint), height 0.7s var(--ease-out-quint), border-color 0.5s ease;
  }
  @media (min-width: 1024px) {
    .card-ghost { top: 3.25rem; right: 2.5rem; width: 130px; height: 130px; }
  }
  .card:hover .card-ghost {
    border-color: rgba(255, 106, 44, 0.28);
    width: 150px;
    height: 150px;
  }
</style>
