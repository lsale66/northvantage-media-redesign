---
const columns = [
  {
    title: 'Work',
    links: [
      { label: 'Gallery', href: '/gallery' },
      { label: 'Services', href: '/services' },
      { label: 'Pricing', href: '/pricing' },
    ],
  },
  {
    title: 'Studio',
    links: [
      { label: 'About', href: '/about' },
      { label: 'Contact', href: '/contact' },
      { label: 'Book online', href: '/book' },
    ],
  },
  {
    title: 'Where we shoot',
    links: [
      { label: 'Calgary', href: '/contact' },
      { label: 'Airdrie & Cochrane', href: '/contact' },
      { label: 'Chestermere & Okotoks', href: '/contact' },
    ],
  },
];
---

<footer class="relative overflow-hidden border-t border-brand-text/10 bg-brand-bg px-5 pb-10 pt-20 sm:px-8 lg:px-12 lg:pt-28">
  <!-- Oversized bracket watermark -->
  <span class="watermark" aria-hidden="true"></span>

  <div class="relative mx-auto w-full max-w-[1500px]">
    <div class="grid gap-14 lg:grid-cols-[1.35fr_1fr] lg:gap-20">
      <!-- Brand -->
      <div>
        <img src="/images/redesign/logo.png" alt="Northvantage Media" class="h-9 w-auto" width="200" height="36" loading="lazy" decoding="async" />
        <p class="mt-8 max-w-[34ch] font-heading text-[1.5rem] leading-[1.2] tracking-[-0.025em] text-brand-text lg:text-[1.75rem]">
          Calgary's listing media partner for homes that deserve more than a
          phone-camera walkthrough.
        </p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a href="/contact" class="pill pill-accent pill-sm">Call or Text</a>
          <a href="/book" class="pill pill-outline pill-sm">Book Online</a>
        </div>
      </div>

      <!-- Nav columns -->
      <div class="grid grid-cols-2 gap-8 sm:grid-cols-3">
        {columns.map((c) => (
          <div>
            <p class="eyebrow">{c.title}</p>
            <ul class="mt-6 flex flex-col gap-3.5">
              {c.links.map((l) => (
                <li>
                  <a href={l.href} class="foot-link">{l.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <!-- Sign-off -->
    <div class="mt-16 flex flex-col gap-6 border-t border-brand-text/10 pt-8 lg:mt-24 lg:flex-row lg:items-center lg:justify-between">
      <p class="signoff">
        <span class="signoff-mark" aria-hidden="true"></span>
        Shot in Calgary. Graded after dark. In your inbox by nine.
      </p>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
        <span class="meta text-[9px] text-brand-muted">© 2026 Northvantage Media</span>
        <span class="hidden h-3 w-px bg-brand-text/15 sm:block"></span>
        <span class="meta text-[9px] text-brand-muted">Shooting since Oct 2023</span>
        <span class="hidden h-3 w-px bg-brand-text/15 sm:block"></span>
        <span class="meta flex items-center gap-2 text-[9px] text-brand-muted">
          <img src="/images/redesign/image-01.png" alt="" class="h-3 w-3" width="12" height="12" aria-hidden="true" />
          5.0 on Google
        </span>
      </div>
    </div>
  </div>
</footer>

<style>
  .watermark {
    position: absolute;
    right: -3rem;
    bottom: -4rem;
    width: 300px;
    height: 300px;
    border-right: 2px solid rgba(236, 239, 243, 0.055);
    border-bottom: 2px solid rgba(236, 239, 243, 0.055);
    border-bottom-right-radius: 8px;
    pointer-events: none;
  }
  @media (min-width: 1024px) {
    .watermark { width: 460px; height: 460px; right: -5rem; bottom: -6rem; }
  }

  .foot-link {
    font-size: 14px;
    color: rgba(236, 239, 243, 0.62);
    transition: color 0.3s var(--ease-out-quint), padding-left 0.35s var(--ease-snap);
    display: inline-block;
  }
  .foot-link:hover {
    color: var(--color-brand-text);
    padding-left: 6px;
  }

  .signoff {
    position: relative;
    padding-left: 1.5rem;
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 400;
    letter-spacing: -0.012em;
    color: rgba(236, 239, 243, 0.72);
  }
  .signoff-mark {
    position: absolute;
    left: 0;
    top: 0.28rem;
    width: 11px;
    height: 11px;
    border-left: 1.5px solid var(--color-brand-accent);
    border-top: 1.5px solid var(--color-brand-accent);
  }
</style>
