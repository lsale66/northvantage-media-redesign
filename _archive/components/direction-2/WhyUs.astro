---
const reasons = [
  {
    title: 'One set of hands, one look.',
    body: 'The same shooter, the same lenses, the same grade on every listing you send us. Scroll an agent’s feed and you can tell instantly whether their media came from one studio or five freelancers — yours will read as a body of work.',
  },
  {
    title: 'In your inbox by nine, next morning.',
    body: 'Shoot before noon, files land the following morning: full-resolution, MLS-sized and social-cropped, all in one link. No chasing, no “sometime this week”, no separate email for the floor plan.',
  },
  {
    title: 'Lit, not just captured.',
    body: 'Flash-blended interiors, real twilight windows, verticals kept vertical. It is the difference between a room that has been documented and a room that has been sold — and it is why our galleries hold up on a 27-inch monitor.',
  },
];
---

<section id="why" class="relative overflow-hidden bg-brand-primary">
  <div class="pointer-events-none absolute inset-0 opacity-[0.55]" style="background: radial-gradient(120% 90% at 85% 10%, rgba(61,85,120,0.55) 0%, rgba(33,50,77,0) 60%)" aria-hidden="true"></div>

  <div class="relative grid lg:grid-cols-[0.44fr_0.56fr]">
    <!-- Image bleeds off the left viewport edge -->
    <div class="relative min-h-[300px] lg:min-h-[760px]">
      <div class="absolute inset-0 overflow-hidden">
        <img
          src="/images/redesign/image-02.jpg"
          alt="Aerial view of downtown Calgary and the Bow River"
          class="absolute inset-0 h-full w-full object-cover"
          style="object-position: 62% 50%; filter: saturate(0.62) contrast(1.08) brightness(0.62)"
          loading="lazy"
          decoding="async"
        />
        <div class="absolute inset-0" style="background: linear-gradient(105deg, rgba(33,50,77,0.5) 0%, rgba(22,35,58,0.72) 55%, rgba(33,50,77,0.97) 100%)" aria-hidden="true"></div>
      </div>

      <span class="corner-mark" aria-hidden="true"></span>
      <span class="meta absolute bottom-6 left-6 text-[9px] text-brand-text/70 lg:bottom-10 lg:left-10">Calgary AB · Bow River</span>

      <!-- Overlaps the column boundary -->
      <div class="claim" data-reveal="slide">
        <span class="meta text-[9px] text-brand-accent">Since October 2023</span>
        <p class="mt-3 font-heading text-[1.35rem] leading-[1.15] tracking-[-0.02em] text-brand-text">
          One photographer. Every job.
        </p>
      </div>
    </div>

    <!-- Reasons -->
    <div class="px-5 py-24 sm:px-8 lg:px-16 lg:py-32 xl:px-24">
      <div class="max-w-[46rem]">
        <p class="eyebrow eyebrow-light" data-reveal="up">Why agents re-book</p>
        <h2 class="h2 mt-6 text-brand-text" data-reveal="up" style="--i:1">
          <strong>Consistency</strong> is the actual product.
        </h2>
        <p class="mt-7 max-w-[46ch] text-[15px] leading-[1.7] text-brand-text/60" data-reveal="up" style="--i:2">
          Anyone can get one good listing out the door. Doing it on the fortieth
          listing, in February, on a two-day turnaround, is the part agents pay for.
        </p>

        <div class="mt-14 flex flex-col">
          {reasons.map((r, i) => (
            <div class="reason" data-reveal="up" style={`--i:${i}`}>
              <span class="reason-mark" aria-hidden="true"></span>
              <h3 class="h3 text-brand-text">{r.title}</h3>
              <p class="mt-3.5 max-w-[52ch] text-[14.5px] leading-[1.7] text-brand-text/60">{r.body}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .corner-mark {
    position: absolute;
    top: 1.5rem;
    left: 1.5rem;
    width: 22px;
    height: 22px;
    border-left: 1.5px solid rgba(236, 239, 243, 0.55);
    border-top: 1.5px solid rgba(236, 239, 243, 0.55);
  }
  @media (min-width: 1024px) {
    .corner-mark { top: 2.5rem; left: 2.5rem; width: 30px; height: 30px; }
  }

  .claim {
    position: absolute;
    left: 1.5rem;
    right: 1.5rem;
    bottom: 4.5rem;
    border-radius: 18px;
    border: 1px solid rgba(255, 106, 44, 0.35);
    background: rgba(12, 16, 21, 0.86);
    backdrop-filter: blur(10px);
    padding: 1.25rem 1.4rem;
    box-shadow: var(--print-lift);
  }
  @media (min-width: 1024px) {
    .claim {
      left: auto;
      right: -3.5rem;
      bottom: 5.5rem;
      width: 17.5rem;
      padding: 1.5rem 1.6rem;
      z-index: 5;
    }
  }

  .reason {
    position: relative;
    padding: 2rem 0 2rem 2.25rem;
    border-top: 1px solid rgba(236, 239, 243, 0.14);
    transition: border-color 0.4s var(--ease-out-quint);
  }
  .reason:last-child { border-bottom: 1px solid rgba(236, 239, 243, 0.14); }
  .reason:hover { border-color: rgba(255, 106, 44, 0.5); }
  .reason-mark {
    position: absolute;
    top: 2.1rem;
    left: 0;
    width: 12px;
    height: 12px;
    border-left: 1.5px solid var(--color-brand-accent);
    border-top: 1.5px solid var(--color-brand-accent);
    transition: width 0.45s var(--ease-snap), height 0.45s var(--ease-snap);
  }
  .reason:hover .reason-mark { width: 22px; height: 22px; }
</style>
