---
const frames = [
  {
    cls: 'a',
    src: '/images/redesign/image-03.jpg',
    alt: 'Front elevation of a Calgary home photographed at twilight, interior lights on',
    pos: '50% 62%',
    caption: 'Front elevation, lights on',
    tag: 'Twilight',
    reveal: 'bloom',
  },
  {
    cls: 'b',
    src: '/images/redesign/image-03.jpg',
    alt: 'Detail frame of the covered entry and lit front windows at dusk',
    pos: '64% 52%',
    caption: 'Entry and porch light',
    tag: 'Detail',
    reveal: 'rise',
  },
  {
    cls: 'c',
    src: '/images/redesign/image-03.jpg',
    alt: 'Roof gable of the home against a deep blue dusk sky',
    pos: '34% 12%',
    caption: 'Gable against the sky',
    tag: 'Exterior',
    reveal: 'rise',
  },
];
---

<section class="work" id="work">
  <div class="bloom work__bloom" aria-hidden="true"></div>

  <header class="work__head shell">
    <div class="work__headText">
      <p class="eyebrow" data-reveal="fade">Selected work</p>
      <h2 class="display work__title" data-reveal="rise" data-rd="100">
        One address. One evening.<br />Everything the listing <b>needed</b>.
      </h2>
    </div>
    <p class="lede work__headNote" data-reveal="rise" data-rd="200">
      A single Calgary booking, shot from late afternoon through the last usable
      light. The sky moves about four stops in twenty minutes — that's the whole
      job, and it's why we scout before we shoot.
    </p>
  </header>

  <div class="work__grid shell">
    {frames.map((f, i) => (
      <figure class={`frame frame--${f.cls}`} data-reveal={f.reveal} data-rd={`${i * 120}`}>
        <div class="frame__win">
          <img src={f.src} alt={f.alt} style={`object-position:${f.pos}`} loading="lazy" decoding="async" />
          <span class="frame__wash" aria-hidden="true"></span>
        </div>
        <figcaption class="frame__cap">
          <!-- MOTIF 5: a horizon under every caption -->
          <span class="horizon frame__rule" aria-hidden="true"></span>
          <span class="frame__capRow">
            <span class="frame__capText">{f.caption}</span>
            <span class="frame__tag">{f.tag}</span>
          </span>
        </figcaption>
      </figure>
    ))}
  </div>

  <figure class="aerial" data-reveal="bloom">
    <div class="aerial__win">
      <img
        src="/images/redesign/image-02.jpg"
        alt="Aerial view of the Bow River and downtown Calgary at golden hour"
        loading="lazy"
        decoding="async"
        data-parallax="0.05"
      />
      <span class="aerial__wash" aria-hidden="true"></span>
    </div>
    <figcaption class="aerial__cap shell">
      <span class="aerial__text">Bow River corridor — inner-city Calgary</span>
      <span class="aerial__tag">Drone</span>
      <a class="tlink aerial__link" href="/gallery">See the full gallery <span class="arw">&#8594;</span></a>
    </figcaption>
  </figure>
</section>

<style>
  .work {
    position: relative;
    padding-block: 0 clamp(4rem, 9vw, 8rem);
  }
  .work__bloom {
    width: min(60vw, 700px);
    height: min(60vw, 700px);
    right: -18vw;
    top: 4%;
    opacity: 0.16;
  }

  .work__head {
    position: relative;
    display: grid;
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: end;
    margin-bottom: clamp(2.5rem, 5vw, 4.5rem);
  }
  .work__title {
    margin: 1.4rem 0 0;
    font-size: clamp(1.9rem, 4vw, 3.6rem);
  }
  .work__headNote { max-width: 44ch; }

  /* ── The grid break ──────────────────────────────────────
     Frame C climbs out of the top of the section and sits over
     the services block above it. */
  .work__grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: clamp(1rem, 2.2vw, 2rem);
  }

  .frame { margin: 0; }
  .frame__win {
    position: relative;
    overflow: hidden;
    background: var(--bh-surface);
  }
  .frame__win img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.02);
    transition: transform 1.4s var(--ease), filter 1.1s var(--ease);
    filter: saturate(0.92) brightness(0.92);
  }
  .frame:hover .frame__win img {
    transform: scale(1.07);
    filter: saturate(1.05) brightness(1.02);
  }

  /* glow-intensify on hover, delivered as a blurred wash */
  .frame__wash {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(90% 70% at 50% 110%, rgb(var(--glow) / 0.55), transparent 70%);
    opacity: 0;
    transition: opacity 0.9s var(--ease);
    mix-blend-mode: screen;
  }
  .frame:hover .frame__wash { opacity: 0.55; }

  .frame__cap { margin-top: 1rem; }
  .frame__rule { opacity: 0.28; transition: opacity 0.7s var(--ease); }
  .frame:hover .frame__rule { opacity: 1; }

  .frame__capRow {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.75rem;
  }
  .frame__capText {
    font-family: var(--font-heading);
    font-weight: 300;
    font-size: clamp(0.9375rem, 1.2vw, 1.0625rem);
    letter-spacing: -0.01em;
  }
  .frame__tag {
    flex: none;
    font-size: 0.5625rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--bh-accent);
  }

  /* Mobile stacking */
  .frame--a { grid-column: 1 / -1; }
  .frame--a .frame__win { aspect-ratio: 16 / 10; }
  .frame--b { grid-column: 1 / -1; }
  .frame--b .frame__win { aspect-ratio: 4 / 5; }
  .frame--c { grid-column: 1 / -1; }
  .frame--c .frame__win { aspect-ratio: 1 / 1; }

  /* ── Aerial: full bleed, running past the section floor ── */
  .aerial {
    position: relative;
    margin: clamp(3rem, 7vw, 6.5rem) 0 calc(-1 * clamp(2rem, 6vw, 6rem));
    z-index: 2;
  }
  .aerial__win {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    max-height: 68vh;
  }
  .aerial__win img {
    display: block;
    width: 100%;
    height: 112%;
    margin-top: -6%;
    object-fit: cover;
    /* the daylight aerial is graded back toward dusk so it belongs
       to the same evening as everything else on the page */
    filter: saturate(0.55) brightness(0.62) contrast(1.08) hue-rotate(-8deg);
    transition: filter 1.2s var(--ease);
  }
  .aerial:hover .aerial__win img { filter: saturate(0.8) brightness(0.76) contrast(1.05) hue-rotate(-4deg); }

  .aerial__wash {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgb(7 11 20 / 0.72), rgb(7 11 20 / 0.05) 42%, rgb(7 11 20 / 0.9)),
      linear-gradient(to right, rgb(22 35 61 / 0.55), transparent 60%);
  }

  .aerial__cap {
    position: absolute;
    left: 0;
    right: 0;
    bottom: clamp(1.25rem, 3vw, 2.5rem);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1.25rem;
  }
  .aerial__text {
    font-family: var(--font-heading);
    font-weight: 300;
    font-size: clamp(1rem, 1.6vw, 1.45rem);
    letter-spacing: -0.02em;
  }
  .aerial__tag {
    font-size: 0.5625rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--bh-accent);
    padding: 0.35rem 0.7rem;
    border: 1px solid rgb(var(--glow) / 0.4);
  }
  .aerial__link { margin-left: auto; }

  @media (min-width: 860px) {
    .work__head { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }

    .frame--a { grid-column: 1 / span 7; }
    .frame--b {
      grid-column: 9 / span 4;
      margin-top: calc(-1 * clamp(4rem, 11vw, 11rem));
    }
    .frame--c {
      grid-column: 3 / span 5;
      margin-top: clamp(1.5rem, 4vw, 3.5rem);
    }
    .frame--b .frame__win { aspect-ratio: 3 / 4.4; }
  }

  @media (min-width: 1180px) {
    .frame--b { margin-top: calc(-1 * clamp(6rem, 13vw, 14rem)); }
    .frame--c { grid-column: 2 / span 5; margin-top: clamp(2rem, 5vw, 5rem); }
  }
</style>
