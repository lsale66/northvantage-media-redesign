---
/**
 * Drag-to-compare before/after image slider.
 * The "before" image sits on top and is clipped to the handle position.
 */
interface Props {
  before: { src: string; alt: string; width: number; height: number };
  after: { src: string; alt: string; width: number; height: number };
  label: string;
  /** Inline style passthrough, e.g. reveal delay. */
  style?: string;
}

const { before, after, label, style = '' } = Astro.props;
---

<div class="nv-twi-slider nv-frame" data-reveal="fade" style={`--pos: 50%; ${style}`}>
  <img
    class="nv-twi-slider__img"
    src={after.src}
    alt={after.alt}
    width={after.width}
    height={after.height}
    loading="lazy"
  />
  <img
    class="nv-twi-slider__img nv-twi-slider__before"
    src={before.src}
    alt={before.alt}
    width={before.width}
    height={before.height}
    loading="lazy"
  />
  <span class="nv-twi-slider__tag nv-twi-slider__tag--before">Before</span>
  <span class="nv-twi-slider__tag nv-twi-slider__tag--after">After</span>
  <span class="nv-twi-slider__line" aria-hidden="true">
    <span class="nv-twi-slider__grip">
      <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
        <path d="M4.5 1.5L1 6l3.5 4.5M7.5 1.5L11 6l-3.5 4.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </span>
  </span>
  <input
    type="range"
    class="nv-twi-slider__range"
    min="0"
    max="100"
    value="50"
    aria-label={label}
  />
</div>

<script>
  document.querySelectorAll<HTMLElement>('.nv-twi-slider').forEach((el) => {
    const range = el.querySelector('.nv-twi-slider__range');
    if (!(range instanceof HTMLInputElement)) return;
    el.style.setProperty('--pos', `${range.value}%`);
    range.addEventListener('input', () => {
      el.style.setProperty('--pos', `${range.value}%`);
    });
  });
</script>

<style>
  .nv-twi-slider {
    --nv-frame-size: 20px;
    --nv-frame-inset: -1px;
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: 2px;
    cursor: ew-resize;
    touch-action: pan-y;
  }

  .nv-twi-slider__img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .nv-twi-slider__before {
    clip-path: inset(0 calc(100% - var(--pos, 50%)) 0 0);
  }

  .nv-twi-slider__tag {
    position: absolute;
    top: 1.25rem;
    z-index: 2;
    padding: 0.4rem 0.85rem;
    background: rgb(10 14 23 / 0.72);
    backdrop-filter: blur(6px);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-brand-text);
    pointer-events: none;
  }
  .nv-twi-slider__tag--before {
    left: 1.25rem;
  }
  .nv-twi-slider__tag--after {
    right: 1.25rem;
  }

  .nv-twi-slider__line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos, 50%);
    z-index: 2;
    width: 2px;
    background: var(--color-brand-text);
    transform: translateX(-50%);
    pointer-events: none;
  }
  .nv-twi-slider__grip {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    background: var(--color-brand-text);
    color: #0a0e17;
    transform: translate(-50%, -50%);
    gap: 4px;
    box-shadow: 0 6px 20px rgb(0 0 0 / 0.35);
  }

  .nv-twi-slider__range {
    position: absolute;
    inset: 0;
    z-index: 3;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
    -webkit-appearance: none;
    appearance: none;
    background: transparent;
  }
  .nv-twi-slider__range::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 40px;
    height: 100%;
  }
  .nv-twi-slider__range::-moz-range-thumb {
    width: 40px;
    height: 100%;
    border: 0;
    background: transparent;
  }
</style>
