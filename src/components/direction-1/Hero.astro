---
import FrameMark from './FrameMark.astro';
---

<section class="nv-hero" id="top">
  <!-- Full-bleed twilight exterior: the hero is the portfolio -->
  <div class="nv-hero__media" data-parallax="0.13">
    <img
      src="/images/redesign/image-03.jpg"
      alt="Twilight exterior of a Calgary luxury home, windows lit against a deep blue sky"
      width="1920"
      height="1245"
      fetchpriority="high"
      data-kenburns
    />
    <div class="nv-hero__video" aria-hidden="true"><div id="nv-hero-player"></div></div>
    <div class="nv-hero__scrim" aria-hidden="true"></div>
    <div class="nv-hero__glow" aria-hidden="true"></div>
  </div>

  <!-- The motif at full viewport scale: we are framing the shot -->
  <div class="nv-hero__corners" aria-hidden="true">
    <span class="nv-hero__corner nv-hero__corner--tl"></span>
    <span class="nv-hero__corner nv-hero__corner--br"></span>
  </div>

  <div class="nv-hero__body nv-wrap">
    <p class="nv-eyebrow nv-hero__eyebrow">
      <FrameMark size={12} float />
      <span>Calgary &amp; Area · Listing Media Production</span>
    </p>

    <h1 class="nv-display nv-hero__title">
      <span class="nv-hero__line" style="--d:0.82s"
        ><span><strong class="nv-accent-word">Calgary</strong> Real Estate</span></span
      >
      <span class="nv-hero__line" style="--d:0.94s"
        ><span>Media &amp; Marketing</span></span
      >
    </h1>

    <div class="nv-hero__grid">
      <div class="nv-hero__pitch">
        <p class="nv-lead">
          Northvantage creates media that sells listings and builds agent
          brands — property tours, branding videos and social reels. Plus
          MLS-ready photography, drone, iGUIDE 3D tours and RMS floor plans.
        </p>
        <div class="nv-hero__ctas">
          <a href="#contact" class="nv-btn nv-btn--solid nv-hero__cta-a">
            <span>Call or Text</span>
            <FrameMark size={11} dot={false} />
          </a>
          <a href="#pricing" class="nv-btn nv-btn--line nv-hero__cta-b">
            <span>Book Online</span>
          </a>
        </div>
      </div>

      <ul class="nv-hero__proof">
        <li>
          <img
            class="nv-hero__proof-icon"
            src="/images/redesign/image-01.png"
            alt=""
            width="14"
            height="14"
            loading="lazy"
          />
          <span class="nv-micro">5.0 on Google</span>
        </li>
        <li><span class="nv-micro">335+ Homes Shot</span></li>
        <li><span class="nv-micro">Next-Morning Delivery</span></li>
      </ul>
    </div>

    <div class="nv-hero__foot">
      <a href="#work" class="nv-scroll">
        <span class="nv-scroll__label">Scroll</span>
        <span class="nv-scroll__track"><span class="nv-scroll__dot"></span></span
        >
      </a>
    </div>
  </div>
</section>

<style>
  .nv-hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 100svh;
    padding-top: 8rem;
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
    overflow: hidden;
    isolation: isolate;
  }

  /* ── Media ── */
  .nv-hero__media {
    position: absolute;
    inset: -8% 0 -8% 0;
    z-index: -2;
    clip-path: inset(0 0 100% 0);
    transform: translate3d(0, var(--py, 0px), 0);
    animation: nv-hero-wipe 1.5s cubic-bezier(0.16, 1, 0.3, 1) 0.12s forwards;
  }
  @keyframes nv-hero-wipe {
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  .nv-hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 62%;
    filter: saturate(0.94) contrast(1.06) brightness(0.86);
    will-change: transform;
  }
  img[data-kenburns] {
    animation: nv-kenburns 34s ease-in-out infinite alternate;
  }
  @keyframes nv-kenburns {
    from {
      transform: scale(1.02) translate3d(0, 0, 0);
    }
    to {
      transform: scale(1.11) translate3d(-1.6%, -1%, 0);
    }
  }

  /* ── Background video: covers the poster once it starts playing ── */
  .nv-hero__video {
    position: absolute;
    inset: 0;
    overflow: hidden;
    opacity: 0;
    transition: opacity 1.4s ease;
  }
  .nv-hero__video.is-playing {
    opacity: 1;
  }
  /* The iframe is injected by the YouTube API without Astro's scope
     attribute, so this child selector has to be :global to reach it. */
  .nv-hero__video :global(iframe) {
    position: absolute;
    top: 50%;
    left: 50%;
    width: max(100vw, 177.78svh);
    height: max(100svh, 56.25vw);
    transform: translate(-50%, -50%) scale(1.2);
    transform-origin: center;
    border: 0;
    pointer-events: none;
    filter: saturate(0.94) contrast(1.06) brightness(0.86);
  }

  .nv-hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to top,
        var(--color-brand-bg) 2%,
        rgb(10 14 23 / 0.82) 22%,
        rgb(10 14 23 / 0.25) 55%,
        rgb(10 14 23 / 0.45) 100%
      ),
      linear-gradient(
        to right,
        rgb(10 14 23 / 0.72) 0%,
        rgb(10 14 23 / 0.12) 55%,
        transparent 100%
      ),
      linear-gradient(rgb(27 42 69 / 0.34), rgb(27 42 69 / 0.34));
  }

  /* Ambient warm bloom — the porch lights breathing */
  .nv-hero__glow {
    position: absolute;
    left: 4%;
    bottom: 6%;
    width: min(760px, 82vw);
    height: min(520px, 46vh);
    background: radial-gradient(
      ellipse at center,
      rgb(232 132 60 / 0.16),
      transparent 68%
    );
    filter: blur(30px);
    animation: nv-bloom 11s ease-in-out infinite alternate;
  }
  @keyframes nv-bloom {
    from {
      opacity: 0.55;
      transform: scale(0.94);
    }
    to {
      opacity: 1;
      transform: scale(1.08);
    }
  }

  /* ── Viewport framing corners ── */
  .nv-hero__corners {
    position: absolute;
    inset: clamp(1rem, 2.4vw, 2.2rem);
    z-index: 2;
    pointer-events: none;
  }
  .nv-hero__corner {
    position: absolute;
    width: 0;
    height: 0;
    border: 0 solid rgb(243 239 231 / 0.34);
    animation: nv-corner-draw 1.1s cubic-bezier(0.16, 1, 0.3, 1) 0.55s forwards;
  }
  .nv-hero__corner--tl {
    top: 0;
    left: 0;
    border-width: 1px 0 0 1px;
  }
  .nv-hero__corner--br {
    bottom: 0;
    right: 0;
    border-width: 0 1px 1px 0;
    animation-delay: 0.72s;
  }
  @keyframes nv-corner-draw {
    to {
      width: clamp(34px, 5vw, 66px);
      height: clamp(34px, 5vw, 66px);
    }
  }

  /* ── Content ── */
  .nv-hero__body {
    position: relative;
    z-index: 3;
    width: 100%;
  }

  .nv-hero__eyebrow {
    opacity: 0;
    animation: nv-rise 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.7s forwards;
  }
  @keyframes nv-rise {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .nv-hero__title {
    margin: clamp(1.4rem, 2.6vw, 2.2rem) 0 0;
    max-width: 21ch;
    font-size: clamp(2.4rem, 6vw, 5.6rem);
    line-height: 1.08;
  }
  .nv-hero__line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.18em;
  }
  .nv-hero__line > span {
    display: inline-block;
    position: relative;
    transform: translateY(110%);
    animation: nv-line-up 1.25s cubic-bezier(0.16, 1, 0.3, 1) var(--d) forwards;
  }
  @keyframes nv-line-up {
    to {
      transform: translateY(0);
    }
  }

  .nv-hero__grid {
    margin-top: clamp(2.2rem, 4vw, 3.4rem);
  }

  .nv-hero__pitch {
    max-width: 46ch;
    opacity: 0;
    animation: nv-rise 1s cubic-bezier(0.16, 1, 0.3, 1) 1.08s forwards;
  }
  .nv-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: clamp(1.6rem, 2.6vw, 2.2rem);
  }
  .nv-hero__ctas > a {
    flex: 1 1 auto;
    min-width: 172px;
  }
  @media (min-width: 520px) {
    .nv-hero__ctas > a {
      flex: 0 0 auto;
    }
  }
  .nv-hero__cta-a,
  .nv-hero__cta-b {
    opacity: 0;
    animation: nv-rise 0.85s cubic-bezier(0.16, 1, 0.3, 1) 1.24s forwards;
  }
  .nv-hero__cta-b {
    animation-delay: 1.36s;
  }

  /* ── Proof strip ── */
  .nv-hero__proof {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.9rem 1.4rem;
    margin: clamp(1.75rem, 3vw, 2.25rem) 0 0;
    padding: 0;
    list-style: none;
    opacity: 0;
    animation: nv-rise 0.9s cubic-bezier(0.16, 1, 0.3, 1) 1.46s forwards;
  }
  @media (min-width: 700px) {
    .nv-hero__proof {
      flex-wrap: nowrap;
    }
  }
  .nv-hero__proof li {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    white-space: nowrap;
  }
  .nv-hero__proof li + li::before {
    content: '';
    position: absolute;
    left: -0.75rem;
    top: 50%;
    width: 3px;
    height: 3px;
    background: var(--color-brand-accent);
    transform: translateY(-50%);
  }
  .nv-hero__proof-icon {
    width: 14px;
    height: 14px;
    object-fit: contain;
    flex: none;
  }

  /* ── Foot bar ── */
  .nv-hero__foot {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: clamp(2.6rem, 5vw, 4.4rem);
    padding-top: 1.35rem;
    border-top: 1px solid var(--nv-hairline);
    opacity: 0;
    animation: nv-rise 1s cubic-bezier(0.16, 1, 0.3, 1) 1.68s forwards;
  }

  .nv-scroll {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    text-decoration: none;
  }
  .nv-scroll__label {
    font-size: 0.625rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-brand-muted);
    transition: color 0.5s var(--nv-ease);
  }
  .nv-scroll:hover .nv-scroll__label {
    color: var(--color-brand-text);
  }
  .nv-scroll__track {
    position: relative;
    display: block;
    width: 54px;
    height: 1px;
    background: rgb(243 239 231 / 0.2);
    overflow: hidden;
  }
  .nv-scroll__dot {
    position: absolute;
    top: -1px;
    left: 0;
    width: 16px;
    height: 3px;
    background: var(--color-brand-accent);
    animation: nv-sweep 3.2s cubic-bezier(0.33, 1, 0.68, 1) infinite;
  }
  @keyframes nv-sweep {
    0% {
      transform: translateX(-18px);
    }
    60%,
    100% {
      transform: translateX(56px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nv-hero__video {
      display: none;
    }
    .nv-hero__media,
    .nv-hero__eyebrow,
    .nv-hero__pitch,
    .nv-hero__proof,
    .nv-hero__foot,
    .nv-hero__cta-a,
    .nv-hero__cta-b {
      opacity: 1;
      clip-path: none;
      animation: none;
    }
    .nv-hero__line > span {
      transform: none;
      animation: none;
    }
    .nv-hero__corner {
      width: 46px;
      height: 46px;
      animation: none;
    }
  }
</style>

<script>
  // Muted, looping YouTube background for the hero. Starts 4s in and
  // loops back to 4s (not 0), so the intro frames never replay.
  const MOUNT = 'nv-hero-player';
  const VIDEO_ID = 'gyvaricJimI';
  const START = 4;

  const mount = document.getElementById(MOUNT);
  const shell = document.querySelector('.nv-hero__video');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (mount && shell && !reduced && !shell.querySelector('iframe')) {
    const boot = () => {
      const player = new YT.Player(MOUNT, {
        videoId: VIDEO_ID,
        host: 'https://www.youtube-nocookie.com',
        playerVars: {
          autoplay: 1,
          mute: 1,
          controls: 0,
          disablekb: 1,
          fs: 0,
          loop: 0,
          modestbranding: 1,
          playsinline: 1,
          rel: 0,
          start: START,
          iv_load_policy: 3,
          cc_load_policy: 0,
        },
        events: {
          onReady: (e) => {
            e.target.mute();
            try {
              e.target.unloadModule('captions');
              e.target.unloadModule('cc');
            } catch (_) {}
            e.target.playVideo();
          },
          onStateChange: (e) => {
            if (e.data === YT.PlayerState.PLAYING) {
              shell.classList.add('is-playing');
            }
            if (e.data === YT.PlayerState.ENDED) {
              e.target.seekTo(START, true);
              e.target.playVideo();
            }
          },
        },
      });

      // Safety net in case ENDED doesn't fire (some browsers throttle
      // the hidden iframe): reset near the end of the clip.
      window.setInterval(() => {
        if (typeof player.getDuration !== 'function') return;
        const d = player.getDuration();
        if (d && player.getCurrentTime() >= d - 0.4) player.seekTo(START, true);
      }, 1000);
    };

    if (window.YT && window.YT.Player) {
      boot();
    } else {
      const prev = window.onYouTubeIframeAPIReady;
      window.onYouTubeIframeAPIReady = () => {
        if (typeof prev === 'function') prev();
        boot();
      };
      if (!document.querySelector('script[src*="youtube.com/iframe_api"]')) {
        const tag = document.createElement('script');
        tag.src = 'https://www.youtube.com/iframe_api';
        document.head.appendChild(tag);
      }
    }
  }
</script>
