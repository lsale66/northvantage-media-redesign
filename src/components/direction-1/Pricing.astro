---
import Eyebrow from './Eyebrow.astro';
---

<section class="nv-section nv-pricing" id="pricing">
  <div class="nv-wrap nv-pricing__grid">
    <aside class="nv-pricing__aside">
      <Eyebrow>Packages</Eyebrow>
      <h2 class="nv-h2 nv-pricing__title" data-reveal="clip">
The <span class="nv-accent-word">right package</span> for every listing
      </h2>

      <p class="nv-pricing__from" data-reveal="up" style="--d:100ms">
        <span class="nv-pricing__fromlabel nv-micro">Packages from</span>
        <span class="nv-pricing__fromnum"
          ><span class="nv-pricing__dollar">$</span>285</span
        >
        <span class="nv-micro">+ GST</span>
      </p>

      <p class="nv-body nv-pricing__copy" data-reveal="up" style="--d:160ms">
        Professional real estate photography &amp; video — priced by square
        footage. All packages designed to help you sell faster and build
        your brand.
      </p>

      <a
        href="/pricing"
        class="nv-btn nv-btn--solid nv-pricing__link"
        data-reveal="up"
        style="--d:220ms"
      >
        <span>Full Pricing &amp; Add-Ons</span>
      </a>
    </aside>
  </div>
</section>

<style>
  .nv-pricing {
    background: var(--color-brand-surface);
    border-top: 1px solid var(--nv-hairline);
  }

  .nv-pricing__grid {
    display: grid;
  }

  .nv-pricing__aside {
    max-width: 640px;
  }

  .nv-pricing__title {
    margin: clamp(1.1rem, 2vw, 1.6rem) 0 0;
    max-width: 16ch;
  }

  .nv-pricing__from {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0 0.75rem;
    margin: clamp(2rem, 4vw, 3rem) 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--nv-hairline);
  }
  .nv-pricing__fromlabel {
    flex: 1 0 100%;
    margin-bottom: 0.85rem;
  }
  .nv-pricing__fromnum {
    font-family: var(--font-heading);
    font-weight: 250;
    font-size: clamp(3.5rem, 7vw, 5.75rem);
    line-height: 0.86;
    letter-spacing: -0.055em;
    color: var(--color-brand-text);
    font-variant-numeric: tabular-nums;
  }
  .nv-pricing__dollar {
    font-size: 0.44em;
    color: var(--color-brand-accent);
    vertical-align: 0.5em;
    margin-right: 0.06em;
  }

  .nv-pricing__copy {
    margin: 1.6rem 0 0;
    max-width: 38ch;
  }
  .nv-pricing__link {
    margin-top: 2rem;
  }

</style>
