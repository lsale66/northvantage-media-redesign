---
/**
 * Line-icon set for social links (footer / contact "follow" row).
 * Same 20x20 monoline convention as PriceIcon.
 */
interface Props {
  name: 'instagram' | 'facebook';
  size?: number;
  class?: string;
}
const { name, size = 18, class: className = '' } = Astro.props;

const icons: Record<string, string> = {
  instagram:
    '<rect x="3.2" y="3.2" width="13.6" height="13.6" rx="4.2"/><circle cx="10" cy="10" r="3.3"/><circle cx="14.1" cy="5.9" r="0.6" fill="currentColor" stroke="none"/>',
  facebook:
    '<circle cx="10" cy="10" r="7.3"/><path d="M11.6 17v-6h2l.3-2.3h-2.3V7.2c0-.66.2-1.1 1.1-1.1h1.2V4c-.2 0-.9-.08-1.7-.08-1.7 0-2.9 1.05-2.9 2.98v1.8H7.4V11h1.9v6"/>',
};

const inner = icons[name] ?? '';
---

<svg
  class:list={['nv-sicon', className]}
  width={size}
  height={size}
  viewBox="0 0 20 20"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={inner}
/>

<style>
  .nv-sicon {
    flex: none;
  }
</style>
