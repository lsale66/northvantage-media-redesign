---
import Eyebrow from './Eyebrow.astro';
import BunnyVideo from './BunnyVideo.astro';
import { photos } from '../../data/portfolio';

const horizontalVideo = {
  src: 'https://www.youtube.com/embed/gyvaricJimI?rel=0',
  title: 'Northvantage Media — feature reel',
};

const verticalVideos = [
  'https://iframe.mediadelivery.net/embed/469110/a398883b-93b3-4fc5-a769-2f53e5a536a7?autoplay=true&loop=false&muted=true&preload=false&responsive=true',
  'https://iframe.mediadelivery.net/embed/469110/fa91653c-8e19-4a2c-98ef-5fe4e21adec0?autoplay=true&loop=false&muted=true&preload=false&responsive=true',
  'https://iframe.mediadelivery.net/embed/469110/d06939c7-91da-484b-80ae-00ee67190b93?autoplay=true&loop=false&muted=true&preload=false&responsive=true',
];
---

<section class="nv-section nv-work" id="work">
  <div class="nv-wrap">
    <header class="nv-work__head">
      <div>
        <Eyebrow>Selected Work</Eyebrow>
        <h2 class="nv-h2 nv-work__title" data-reveal="clip">
          See What We <span class="nv-accent-word">Create</span>
        </h2>
      </div>
      <div class="nv-work__headside">
        <p class="nv-body" data-reveal="up" style="--d:120ms">
          Every frame below came off a real Calgary listing shoot — no stock, no
          borrowed portfolio.
        </p>
        <a href="/gallery" class="nv-link" data-reveal="up" style="--d:200ms">
          <span>Full gallery</span>
          <span class="nv-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </header>

    <div class="nv-work__videos">
      <figure class="nv-vid nv-vid--wide nv-frame nv-frame--hover">
        <div class="nv-vid__frame" data-reveal="shot">
          <iframe
            src={horizontalVideo.src}
            title={horizontalVideo.title}
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
        </div>
      </figure>

      <div class="nv-vid__row">
        {
          verticalVideos.map((src, i) => (
            <figure class="nv-vid nv-vid--tall nv-frame nv-frame--hover">
              <div class="nv-vid__frame" data-reveal="shot" style={`--d:${i * 90}ms`}>
                <BunnyVideo src={src} title={`Northvantage Media — vertical reel ${i + 1}`} />
              </div>
            </figure>
          ))
        }
      </div>
    </div>

    <div class="nv-work__photos">
      {
        photos.map((p, i) => (
          <figure class="nv-pic nv-frame nv-frame--hover">
            <button
              type="button"
              class="nv-pic__btn"
              data-lightbox-open
              data-index={i}
              aria-label={`Open photo ${i + 1} of ${photos.length}`}
            >
              <span class="nv-media" data-reveal="shot" style={`--d:${(i % 4) * 70}ms`}>
                <img
                  src={`/images/photos/${encodeURIComponent(p.file)}`}
                  alt={p.alt}
                  width="1620"
                  height="1080"
                  loading="lazy"
                />
              </span>
            </button>
          </figure>
        ))
      }
    </div>
  </div>

  <div class="nv-lightbox" id="nv-lightbox" hidden>
    <div class="nv-lightbox__scrim" data-lightbox-close />
    <div class="nv-lightbox__inner" role="dialog" aria-modal="true" aria-label="Photo viewer">
      <button type="button" class="nv-lightbox__btn nv-lightbox__close" data-lightbox-close aria-label="Close">
        <svg viewBox="0 0 20 20" width="18" height="18" fill="none" aria-hidden="true">
          <path d="M4 4l12 12M16 4L4 16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
      </button>
      <button type="button" class="nv-lightbox__btn nv-lightbox__prev" data-lightbox-prev aria-label="Previous photo">
        <svg viewBox="0 0 20 20" width="18" height="18" fill="none" aria-hidden="true">
          <path d="M12 4l-6 6 6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
      <button type="button" class="nv-lightbox__btn nv-lightbox__next" data-lightbox-next aria-label="Next photo">
        <svg viewBox="0 0 20 20" width="18" height="18" fill="none" aria-hidden="true">
          <path d="M8 4l6 6-6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
      <figure class="nv-lightbox__figure">
        <img class="nv-lightbox__img" id="nv-lightbox-img" src="" alt="" />
        <figcaption class="nv-lightbox__count" id="nv-lightbox-count" />
      </figure>
    </div>
  </div>
</section>

<script define:vars={{ photoData: photos.map((p) => ({ src: `/images/photos/${encodeURIComponent(p.file)}`, alt: p.alt })) }}>
  const lightbox = document.getElementById('nv-lightbox');
  const imgEl = document.getElementById('nv-lightbox-img');
  const countEl = document.getElementById('nv-lightbox-count');
  const openers = Array.from(document.querySelectorAll('[data-lightbox-open]'));
  let current = 0;

  const show = (i) => {
    current = (i + photoData.length) % photoData.length;
    const p = photoData[current];
    imgEl.src = p.src;
    imgEl.alt = p.alt;
    countEl.textContent = `${current + 1} / ${photoData.length}`;
  };

  const open = (i) => {
    show(i);
    lightbox.hidden = false;
    requestAnimationFrame(() => lightbox.classList.add('is-open'));
    document.body.classList.add('nv-locked');
  };

  const close = () => {
    lightbox.classList.remove('is-open');
    document.body.classList.remove('nv-locked');
    window.setTimeout(() => {
      lightbox.hidden = true;
    }, 350);
  };

  openers.forEach((btn) => {
    btn.addEventListener('click', () => open(Number(btn.dataset.index)));
  });

  lightbox.querySelectorAll('[data-lightbox-close]').forEach((el) => {
    el.addEventListener('click', close);
  });
  lightbox.querySelector('[data-lightbox-prev]').addEventListener('click', () => show(current - 1));
  lightbox.querySelector('[data-lightbox-next]').addEventListener('click', () => show(current + 1));

  document.addEventListener('keydown', (e) => {
    if (lightbox.hidden) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowLeft') show(current - 1);
    if (e.key === 'ArrowRight') show(current + 1);
  });
</script>

<style>
  .nv-work {
    background: var(--color-brand-surface);
    border-top: 1px solid var(--nv-hairline);
    overflow: clip;
  }

  .nv-work__head {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  @media (min-width: 860px) {
    .nv-work__head {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      align-items: end;
      gap: clamp(2rem, 5vw, 5rem);
    }
  }
  .nv-work__title {
    margin: clamp(1.1rem, 2vw, 1.6rem) 0 0;
    max-width: 12ch;
  }
  .nv-work__headside {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
  }
  .nv-work__headside .nv-body {
    max-width: 34ch;
  }

  /* ── Video wall: one wide feature reel, three vertical clips ── */
  .nv-work__videos {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.25rem);
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .nv-vid {
    --nv-frame-size: 22px;
    --nv-frame-inset: -12px;
    margin: 0;
    min-width: 0;
  }
  .nv-vid__frame {
    position: relative;
    overflow: hidden;
    border-radius: 2px;
    background: var(--color-brand-surface);
  }
  .nv-vid--wide .nv-vid__frame {
    aspect-ratio: 16 / 9;
  }
  .nv-vid--tall .nv-vid__frame {
    aspect-ratio: 9 / 16;
  }
  .nv-vid__frame iframe {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .nv-vid__row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.25rem);
  }
  @media (max-width: 620px) {
    .nv-vid__row {
      grid-template-columns: 1fr;
    }
  }

  /* ── Photo grid ── */
  .nv-work__photos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2.4vw, 1.75rem);
  }
  @media (min-width: 700px) {
    .nv-work__photos {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 1080px) {
    .nv-work__photos {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .nv-pic {
    --nv-frame-size: 16px;
    --nv-frame-inset: -9px;
    margin: 0;
    min-width: 0;
  }
  .nv-pic .nv-media {
    display: block;
    aspect-ratio: 3 / 2;
  }
  .nv-pic img {
    transition:
      transform 1.1s var(--nv-ease),
      filter 1s var(--nv-ease);
    filter: saturate(0.92) contrast(1.05) brightness(0.9);
  }
  .nv-pic:hover img {
    transform: scale(1.045);
    filter: saturate(1) contrast(1.06) brightness(1);
  }

  .nv-pic__btn {
    all: unset;
    display: block;
    width: 100%;
    cursor: pointer;
  }
  .nv-pic__btn:focus-visible {
    outline: 2px solid var(--color-brand-accent);
    outline-offset: 3px;
  }

  /* ── Lightbox ── */
  .nv-lightbox {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: grid;
    place-items: center;
    padding: 4rem 1.5rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s var(--nv-ease);
  }
  .nv-lightbox.is-open {
    opacity: 1;
    pointer-events: auto;
  }
  .nv-lightbox__scrim {
    position: absolute;
    inset: 0;
    background: rgb(10 14 23 / 0.92);
    backdrop-filter: blur(6px);
  }
  .nv-lightbox__inner {
    position: relative;
    z-index: 1;
    width: min(92vw, 1200px);
  }
  .nv-lightbox__figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  .nv-lightbox__img {
    display: block;
    width: 100%;
    max-height: 78vh;
    object-fit: contain;
    border-radius: 2px;
    transform: scale(0.97);
    transition: transform 0.4s var(--nv-ease);
  }
  .nv-lightbox.is-open .nv-lightbox__img {
    transform: scale(1);
  }
  .nv-lightbox__count {
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-brand-muted);
    font-variant-numeric: tabular-nums;
  }
  .nv-lightbox__btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid rgb(243 239 231 / 0.2);
    background: rgb(10 14 23 / 0.6);
    color: var(--color-brand-text);
    cursor: pointer;
    transition:
      border-color 0.4s var(--nv-ease),
      background-color 0.4s var(--nv-ease);
  }
  .nv-lightbox__btn:hover,
  .nv-lightbox__btn:focus-visible {
    border-color: var(--color-brand-accent);
    background: rgb(10 14 23 / 0.85);
  }
  .nv-lightbox__close {
    top: -3.25rem;
    right: 0;
  }
  .nv-lightbox__prev {
    left: -1rem;
    top: 50%;
    transform: translate(-100%, -50%);
  }
  .nv-lightbox__next {
    right: -1rem;
    top: 50%;
    transform: translate(100%, -50%);
  }
  @media (max-width: 720px) {
    .nv-lightbox__close {
      top: -3rem;
      right: 0;
    }
    .nv-lightbox__prev {
      left: 0.5rem;
      transform: translateY(-50%);
    }
    .nv-lightbox__next {
      right: 0.5rem;
      transform: translateY(-50%);
    }
  }
</style>
