---
/**
 * Home page teaser for /work/. Two rows, each ending in a link to the Work
 * page: a staggered pair of reels beside the video pitch, then the photo
 * pitch beside a small block of thumbnails.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Eyebrow from './Eyebrow.astro';
import BunnyVideo from './BunnyVideo.astro';
import { reels } from '../../data/videos';
import { workPhotos } from '../../data/portfolio';

// Reels 2 and 3 from the videography page.
const featuredReels = [reels[1], reels[2]];

// Thumbnails come from the optimisable copies in src/assets/portfolio/.
const portfolio = import.meta.glob<{ default: ImageMetadata }>('/src/assets/portfolio/*.jpg', { eager: true });
const thumbFiles = [
  '001-twilight (Large).jpg',
  'DJI_0430_1_2_3_4-Large.jpg',
  'DSC04417_8_9-SM.jpg',
  'DSC03866-dh-Edit-Large.jpg',
  'DSC04512-dh-Large.jpg',
  '037-DSC02730-edit.jpg',
];
const thumbs = thumbFiles.map((file) => {
  const mod = portfolio[`/src/assets/portfolio/${file}`];
  if (!mod) throw new Error(`Missing portfolio image: src/assets/portfolio/${file}`);
  return { src: mod.default, alt: workPhotos.find((p) => p.file === file)?.alt ?? '' };
});
---

<section class="nv-section nv-work" id="work">
  <div class="nv-wrap">
    <header class="nv-work__head">
      <Eyebrow>Selected Work</Eyebrow>
      <h2 class="nv-h2 nv-work__title" data-reveal="clip">
        See What We <span class="nv-accent-word">Create</span>
      </h2>
    </header>

    <!-- Row 1: reels left, pitch right -->
    <div class="nv-work__row">
      <div class="nv-work__reels">
        {
          featuredReels.map((r, i) => (
            <figure class:list={['nv-vid', 'nv-frame', 'nv-frame--hover', { 'nv-vid--low': i === 1 }]}>
              <div class="nv-vid__frame" data-reveal="shot" style={`--d:${i * 120}ms`}>
                {r.src && <BunnyVideo src={r.src} title={r.label} />}
              </div>
            </figure>
          ))
        }
      </div>

      <div class="nv-work__pitch">
        <Eyebrow>Social Media Reels</Eyebrow>
        <h3 class="nv-work__subtitle" data-reveal="clip">
          <span class="nv-accent-word">Viral-Style</span> Property Videos
        </h3>
        <p class="nv-body" data-reveal="up" style="--d:100ms">
          Vertical reels designed to stop the scroll on Instagram, Facebook and TikTok. We
          write the script, coach you on camera, and create engaging videos that showcase
          your listing and help you stand out online.
        </p>
        <a href="/work/" class="nv-link" data-reveal="up" style="--d:160ms">
          <span>See our work</span>
          <span class="nv-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <!-- Row 2: pitch left, thumbnails right -->
    <div class="nv-work__row nv-work__row--photos">
      <div class="nv-work__pitch">
        <Eyebrow>Photography</Eyebrow>
        <h3 class="nv-work__subtitle" data-reveal="clip">
          Beautiful, Crisp <span class="nv-accent-word">HD Photos</span>
        </h3>
        <p class="nv-body" data-reveal="up" style="--d:100ms">
          Bright, true-to-life HDR interiors, glowing twilight exteriors and drone aerials,
          edited and delivered next day.
        </p>
        <a href="/work/" class="nv-link" data-reveal="up" style="--d:160ms">
          <span>See our work</span>
          <span class="nv-arrow" aria-hidden="true">→</span>
        </a>
      </div>

      <a href="/work/" class="nv-work__thumbs" aria-label="See our work: real estate photography">
        {
          thumbs.map((t, i) => (
            <span class="nv-pic" data-reveal="shot" style={`--d:${(i % 3) * 70}ms`}>
              <Image
                src={t.src}
                alt={t.alt}
                widths={[320, 480]}
                quality={70}
                sizes="(min-width: 960px) 18vw, 31vw"
                loading="lazy"
              />
            </span>
          ))
        }
      </a>
    </div>
  </div>
</section>

<style>
  .nv-work {
    background: var(--color-brand-surface);
    border-top: 1px solid var(--nv-hairline);
    overflow: clip;
  }

  .nv-work__head {
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .nv-work__title {
    margin: clamp(1.1rem, 2vw, 1.6rem) 0 0;
    max-width: 12ch;
  }

  /* ── Rows: media one side, pitch the other ── */
  .nv-work__row {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: center;
  }
  .nv-work__row + .nv-work__row {
    margin-top: clamp(4rem, 9vw, 7rem);
  }
  @media (min-width: 860px) {
    .nv-work__row {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      gap: clamp(3rem, 7vw, 7rem);
    }
    .nv-work__row--photos {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    }
  }

  .nv-work__pitch {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }
  .nv-work__pitch .nv-body {
    max-width: 40ch;
  }
  .nv-work__subtitle {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 280;
    font-size: clamp(1.9rem, 3.4vw, 3rem);
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--color-brand-text);
    max-width: 14ch;
  }

  /* ── Two reels, the second dropped lower ── */
  .nv-work__reels {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 2rem);
    align-items: start;
    max-width: 620px;
    /* Room for the dropped reel so the row doesn't clip it. */
    padding-bottom: clamp(2.5rem, 7vw, 5.5rem);
  }
  .nv-vid {
    --nv-frame-size: 22px;
    --nv-frame-inset: -12px;
    margin: 0;
    min-width: 0;
  }
  .nv-vid--low {
    transform: translateY(clamp(2.5rem, 7vw, 5.5rem));
  }
  .nv-vid__frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 9 / 16;
    border-radius: 2px;
    background: var(--color-brand-bg);
  }

  /* ── Thumbnail block, one link to /work/ ── */
  .nv-work__thumbs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.5rem, 1vw, 0.75rem);
  }
  .nv-pic {
    display: block;
    overflow: hidden;
    aspect-ratio: 3 / 2;
    border-radius: 2px;
    background: var(--color-brand-bg);
  }
  .nv-pic img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.92) contrast(1.05) brightness(0.9);
    transition:
      transform 1.1s var(--nv-ease),
      filter 1s var(--nv-ease);
  }
  .nv-work__thumbs:hover .nv-pic img,
  .nv-work__thumbs:focus-visible .nv-pic img {
    filter: saturate(1) contrast(1.06) brightness(1);
  }
  .nv-pic:hover img {
    transform: scale(1.05);
  }
  .nv-work__thumbs:focus-visible {
    outline: 2px solid var(--color-brand-accent);
    outline-offset: 4px;
  }
</style>
