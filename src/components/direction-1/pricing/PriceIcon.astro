---
/**
 * Line-icon set for the pricing page. One <PriceIcon name="..." /> per
 * feature row / add-on. Names mirror the Font Awesome icons used on the
 * current northvantagemedia.com/pricing page so the mapping is 1:1:
 *
 *   camera          fa-camera          HDR / Photos Only
 *   ruler           fa-ruler-combined  RMS measurements
 *   floorplan       fa-vector-square   Floor Plan / iGuide
 *   tour            fa-street-view     Virtual Tour
 *   sky             fa-cloud           Blue Sky Replacement
 *   drone           (custom drone svg) Drone photo/video
 *   delivery        fa-shipping-fast   Next Day Delivery
 *   check           fa-check-circle    "Everything from ..."
 *   video           fa-video           Video reel / cinematic
 *   agent           fa-portrait        Agent Introduction / branding
 *   script          fa-clipboard-list  Script writing + coaching
 *   twilight        fa-moon            Twilight photography
 *   staging         fa-couch           Virtual Staging
 *   showcase        fa-home            Cinematic Property Showcase
 *   website         (browser window)   Custom Property Website
 */
interface Props {
  name: string;
  size?: number;
  class?: string;
}
const { name, size = 18, class: className = '' } = Astro.props;

const icons: Record<string, string> = {
  camera:
    '<path d="M3 8.5A1.5 1.5 0 0 1 4.5 7h2l1.2-1.8A1 1 0 0 1 8.5 4.7h3a1 1 0 0 1 .83.5L13.5 7h2A1.5 1.5 0 0 1 17 8.5v7A1.5 1.5 0 0 1 15.5 17h-11A1.5 1.5 0 0 1 3 15.5z"/><circle cx="10" cy="11.5" r="3"/>',
  ruler:
    '<path d="M4 12.5 12.5 4l3.5 3.5L7.5 16z"/><path d="M6.4 10.1l1.3 1.3M8.5 8l1.3 1.3M10.6 5.9l1.3 1.3"/>',
  floorplan:
    '<rect x="4" y="4" width="12" height="12" rx="0.5"/><path d="M4 4h2v2H4zM14 4h2v2h-2zM4 14h2v2H4zM14 14h2v2h-2z" fill="currentColor" stroke="none"/>',
  tour:
    '<circle cx="10" cy="5.5" r="2"/><path d="M7 16v-3.5A2.5 2.5 0 0 1 9.5 10h1A2.5 2.5 0 0 1 13 12.5V16"/><path d="M4.5 15.5c0 1.1 2.5 2 5.5 2s5.5-.9 5.5-2"/>',
  sky:
    '<path d="M6.5 15a3 3 0 0 1-.4-6A4 4 0 0 1 14 8.6a2.7 2.7 0 0 1-.3 5.4z"/>',
  drone:
    '<circle cx="5" cy="5.5" r="2"/><circle cx="15" cy="5.5" r="2"/><circle cx="5" cy="14.5" r="2"/><circle cx="15" cy="14.5" r="2"/><path d="M6.4 6.9 8.5 9h3l2.1-2.1M6.4 13.1 8.5 11h3l2.1 2.1"/><rect x="8" y="8.5" width="4" height="3" rx="0.6"/>',
  delivery:
    '<path d="M3 6h8v8H3z"/><path d="M11 8.5h3l2 2.5v3h-5z"/><circle cx="6" cy="15" r="1.3"/><circle cx="13.5" cy="15" r="1.3"/>',
  check:
    '<circle cx="10" cy="10" r="6.5"/><path d="m7.2 10 2 2 3.6-4"/>',
  video:
    '<rect x="3" y="6.5" width="9.5" height="7" rx="1"/><path d="m12.5 9 4-2v6l-4-2z"/>',
  agent:
    '<rect x="4" y="4" width="12" height="12" rx="1"/><circle cx="10" cy="9" r="2"/><path d="M6.5 15c0-1.9 1.6-3 3.5-3s3.5 1.1 3.5 3"/>',
  script:
    '<rect x="5" y="4.5" width="10" height="11" rx="1"/><path d="M8 4.5V3.5h4v1"/><path d="M8 8.5h4M8 11h4M8 13h2.5"/>',
  twilight:
    '<path d="M14.5 11.5A5.5 5.5 0 0 1 8 5a5 5 0 0 0-.5 2.2 5.5 5.5 0 0 0 7 5.3z"/>',
  staging:
    '<path d="M4 10.5V9a1.5 1.5 0 0 1 1.5-1.5h9A1.5 1.5 0 0 1 16 9v1.5"/><path d="M3.5 10.5h13v3.5a1 1 0 0 1-1 1H4.5a1 1 0 0 1-1-1z"/><path d="M6 15.5v1M14 15.5v1"/>',
  showcase:
    '<path d="M4 9.5 10 4.5l6 5"/><path d="M5.5 8.5V15a.5.5 0 0 0 .5.5h8a.5.5 0 0 0 .5-.5V8.5"/><path d="M8.5 15.5v-4h3v4"/>',
  website:
    '<rect x="3" y="4.5" width="14" height="11" rx="1"/><path d="M3 7.5h14"/><path d="M5 6h.01M6.6 6h.01"/><path d="M6 10.5h5M6 12.8h3.5"/>',
};

const inner = icons[name] ?? icons.check;
---

<svg
  class:list={['nv-picon', className]}
  width={size}
  height={size}
  viewBox="0 0 20 20"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={inner}
/>

<style>
  .nv-picon {
    flex: none;
    color: var(--color-brand-accent);
  }
</style>
