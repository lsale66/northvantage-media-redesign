---
import Eyebrow from '../Eyebrow.astro';

const files = [
  '011-DSC01084 (Large).jpg',
  'DSC03866-dh-Edit-Large.jpg',
  'DSC05410-Large.jpg',
  '052-DJI_0256_pinned (Large).jpg',
  'DSC05800-Large.jpg',
  '2-summer-Large.jpg',
];
---

<section class="nv-section nv-svgal" id="gallery">
  <div class="nv-wrap">
    <header class="nv-svgal__head">
      <div>
        <Eyebrow>Portfolio</Eyebrow>
        <h2 class="nv-h2 nv-svgal__title" data-reveal="clip">
          See Some Of Our <span class="nv-accent-word">Work</span>
        </h2>
      </div>
      <a href="/gallery" class="nv-link" data-reveal="up" style="--d:120ms">
        <span>Full Gallery</span>
        <span class="nv-arrow" aria-hidden="true">→</span>
      </a>
    </header>

    <div class="nv-svgal__grid">
      {
        files.map((file, i) => (
          <figure class="nv-svgal__pic nv-frame nv-frame--hover">
            <div class="nv-media" data-reveal="shot" style={`--d:${(i % 3) * 80}ms`}>
              <img
                src={`/images/photos/${encodeURIComponent(file)}`}
                alt="Real estate photograph of a Calgary listing"
                width="1620"
                height="1080"
                loading="lazy"
              />
            </div>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .nv-svgal {
    background: var(--color-brand-surface);
    border-top: 1px solid var(--nv-hairline);
  }

  .nv-svgal__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .nv-svgal__title {
    margin: clamp(1.1rem, 2vw, 1.6rem) 0 0;
  }

  .nv-svgal__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2.4vw, 1.5rem);
  }
  @media (min-width: 700px) {
    .nv-svgal__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .nv-svgal__pic {
    --nv-frame-size: 16px;
    --nv-frame-inset: -9px;
    margin: 0;
  }
  .nv-svgal__pic .nv-media {
    aspect-ratio: 3 / 2;
  }
  .nv-svgal__pic img {
    transition:
      transform 1.1s var(--nv-ease),
      filter 1s var(--nv-ease);
    filter: saturate(0.92) contrast(1.05) brightness(0.9);
  }
  .nv-svgal__pic:hover img {
    transform: scale(1.045);
    filter: saturate(1) contrast(1.06) brightness(1);
  }
</style>
