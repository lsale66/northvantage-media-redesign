---
import FrameMark from '../FrameMark.astro';
---

<section class="nv-svhero">
  <div class="nv-svhero__media" data-parallax="0.1">
    <img
      src="/images/real-estate-photography/twilight-after.jpg"
      alt="Virtual twilight exterior photograph of a Calgary home, glowing windows against a dusk sky"
      width="1536"
      height="1025"
      fetchpriority="high"
    />
    <div class="nv-svhero__scrim" aria-hidden="true"></div>
  </div>

  <div class="nv-svhero__body nv-wrap">
    <p class="nv-eyebrow" data-reveal="fade">
      <FrameMark size={12} float />
      <span>Real Estate Photography</span>
    </p>

    <h1 class="nv-h2 nv-svhero__title" data-reveal="clip">
      Professional Real Estate <span class="nv-accent-word">Photography</span> in Calgary
    </h1>

    <p class="nv-lead nv-svhero__lead" data-reveal="up" style="--d:120ms">
      Northvantage Media shoots professional real estate photography for
      Calgary realtors — crisp, true-to-life HDR interior and exterior
      images, blue-sky replacement on every exterior, and next-day delivery
      on every listing.
    </p>

    <ul class="nv-svhero__proof" data-reveal="up" style="--d:200ms">
      <li><span class="nv-micro">24-Hour Turnaround</span></li>
      <li><span class="nv-micro">Starting at $149</span></li>
      <li><span class="nv-micro">5-Star Google Rating</span></li>
    </ul>

    <div class="nv-svhero__ctas" data-reveal="up" style="--d:260ms">
      <a href="#pricing" class="nv-btn nv-btn--solid">
        <span>See Packages and Pricing</span>
        <FrameMark size={11} dot={false} />
      </a>
    </div>
  </div>
</section>

<style>
  .nv-svhero {
    position: relative;
    overflow: clip;
    padding-top: clamp(9rem, 16vw, 12rem);
    padding-bottom: clamp(3.5rem, 7vw, 6rem);
  }

  .nv-svhero__media {
    position: absolute;
    /* Oversized beyond the section so the scroll-parallax transform below
       never reveals the section background at the top or bottom edge. */
    inset: -8% 0 -8% 0;
    z-index: -1;
    transform: translate3d(0, var(--py, 0px), 0);
  }
  .nv-svhero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
    filter: saturate(0.9) contrast(1.06) brightness(0.6);
  }
  .nv-svhero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to top,
        var(--color-brand-bg) 4%,
        rgb(10 14 23 / 0.86) 46%,
        rgb(10 14 23 / 0.55) 100%
      ),
      linear-gradient(
        to right,
        rgb(10 14 23 / 0.55) 0%,
        rgb(10 14 23 / 0.1) 60%,
        transparent 100%
      );
  }

  .nv-svhero__body {
    position: relative;
  }

  .nv-svhero__title {
    margin: clamp(1.1rem, 2vw, 1.6rem) 0 0;
    max-width: 18ch;
  }

  .nv-svhero__lead {
    margin: clamp(1.5rem, 2.6vw, 2rem) 0 0;
    max-width: 56ch;
  }

  .nv-svhero__proof {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.4rem;
    margin: clamp(1.75rem, 3vw, 2.25rem) 0 0;
    padding: 0;
    list-style: none;
  }
  .nv-svhero__proof li {
    position: relative;
  }
  .nv-svhero__proof li + li::before {
    content: '';
    position: absolute;
    left: -0.75rem;
    top: 50%;
    width: 3px;
    height: 3px;
    background: var(--color-brand-accent);
    transform: translateY(-50%);
  }

  .nv-svhero__ctas {
    margin-top: clamp(2rem, 3.5vw, 2.75rem);
  }
</style>
