---
import { SEO } from 'astro-seo';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Social share image, path relative to the site root. Assumed 1620×1080. */
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
}

const {
  title,
  description = '',
  image = '/images/photos/001-twilight%20(Large).jpg',
  imageAlt = 'Twilight exterior of a Calgary home photographed by Northvantage Media',
  noindex = false,
} = Astro.props;

const GA_ID = 'G-QMG4PY9CTN';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${Astro.site}#organization`,
  name: 'Northvantage Media',
  url: Astro.site?.href,
  description:
    'Real estate photography, video, RMS measurements, drone, and iGuide virtual tours serving Calgary and area.',
  telephone: '+1-587-885-6499',
  email: 'hello@northvantagemedia.com',
  logo: new URL('/icon-512.png', Astro.site).href,
  image: ogImage,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Calgary',
    addressRegion: 'AB',
    postalCode: 'T2X 1T6',
    addressCountry: 'CA',
  },
  areaServed: { '@type': 'City', name: 'Calgary' },
  openingHours: 'Mo-Sa 09:00-17:00',
  sameAs: [
    'https://www.facebook.com/northvantagemedia',
    'https://www.instagram.com/northvantagemedia/',
    'https://share.google/ki6GMLUZmbMXYdLj8',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO
      title={title}
      description={description}
      canonical={noindex ? null : canonical}
      noindex={noindex}
      openGraph={{
        basic: { title, type: 'website', image: ogImage, url: canonical },
        optional: { description, locale: 'en_CA', siteName: 'Northvantage Media' },
        image: { alt: imageAlt, width: 1620, height: 1080 },
      }}
      twitter={{ card: 'summary_large_image', imageAlt }}
      surpressWarnings
    />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />

    <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
    <script is:inline define:vars={{ GA_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', GA_ID);
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
