---
import { SEO } from 'astro-seo';
import { Schema } from 'astro-seo-schema';
import type { Thing } from 'schema-dts';
import { pageGraph, webpage } from '../lib/schema';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Social share image, path relative to the site root. Assumed 1620×1080. */
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  /** Extra Schema.org nodes for this page (see src/lib/schema.ts). */
  schema?: Thing[];
}

const {
  title,
  description = '',
  image = '/images/photos/001-twilight%20(Large).jpg',
  imageAlt = 'Twilight exterior of a Calgary home photographed by Northvantage Media',
  noindex = false,
  schema = [],
} = Astro.props;

const GA_ID = 'G-QMG4PY9CTN';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;

const jsonLd = pageGraph(webpage(canonical, title, description), noindex ? [] : schema);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO
      title={title}
      description={description}
      canonical={noindex ? null : canonical}
      noindex={noindex}
      openGraph={{
        basic: { title, type: 'website', image: ogImage, url: canonical },
        optional: { description, locale: 'en_CA', siteName: 'Northvantage Media' },
        image: { alt: imageAlt, width: 1620, height: 1080 },
      }}
      twitter={{ card: 'summary_large_image', imageAlt }}
      surpressWarnings
    />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <Schema item={jsonLd} />

    <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
    <script is:inline define:vars={{ GA_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', GA_ID);
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
