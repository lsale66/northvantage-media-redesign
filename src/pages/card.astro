---
/**
 * /card/ — landing page for the QR code on the business card.
 * Written for First Place Realty agents; kept out of search (noindex)
 * so the offer stays with people who were handed a card.
 *
 * One path down the page: perk + save contact → the work → the Essential
 * package → one voice of proof → book. Everything else lives on the main site.
 */
import Layout from '../layouts/Layout.astro';
import Styles from '../components/direction-1/Styles.astro';
import FrameMark from '../components/direction-1/FrameMark.astro';
import Motion from '../components/direction-1/Motion.astro';
import { photos, photoSrc } from '../data/portfolio';

const PHONE = '+15878856499';
const ORDER_URL = 'https://northvantagemedia.hd.pics/order';
const VCARD = '/northvantage-media.vcf';

const essential = [
  'HDR photos',
  'RMS measurements & floor plan',
  'Virtual tour',
  'Blue-sky replacement',
  '24-hour delivery',
];

const testimonials = [
  {
    quote:
      "Lee's attention to detail in lighting, the professional equipment and video editing make the homes stand out.",
    name: 'Anthony Luong',
    img: '/images/redesign/image-04.jpg',
  },
  {
    quote:
      'Great photos. Excellent video creation, giving positive direction and suggestions to create effective videos in a short amount of time.',
    name: 'Lionel Sale',
    img: '/images/redesign/image-06.jpg',
  },
];
---

<Layout
  title="For First Place Realty Agents — Northvantage Media"
  description="Calgary real estate photography, video, RMS and drone for First Place Realty agents. Delivered within 24 hours, and drone photos are free for First Place agents. Call, text, or save Lee's contact."
  noindex
>
  <Styles />

  <div class="nv-grain" aria-hidden="true"></div>

  <main>
    <!-- 1 · Who this is from, the perk, one action -->
    <section class="nv-c-hero">
      <div class="nv-c-hero__glow" aria-hidden="true"></div>
      <div class="nv-c-col">
        <a href="/" class="nv-c-hero__logo" aria-label="Northvantage Media home">
          <img src="/images/redesign/logo.png" alt="" width="56" height="56" />
        </a>

        <h1 class="nv-h2 nv-c-hero__title" data-reveal="clip">
          Real Estate Media That Makes You Look Like a <span class="nv-accent-word">Top Producer</span>.
        </h1>

        <p class="nv-lead nv-c-hero__lead" data-reveal="up" style="--d:100ms">
          Photo, video, RMS &amp; drone — delivered within 24 hours.
        </p>
        <p class="nv-c-hero__perk" data-reveal="up" style="--d:140ms">
          First Place agents get free drone photos.
        </p>

        <div class="nv-c-hero__actions" data-reveal="up" style="--d:180ms" id="hero-actions">
          <a href={VCARD} class="nv-btn nv-btn--solid nv-c-btn" download>
            <span>Save My Contact</span>
          </a>
          <p class="nv-c-quiet">
            or <a href={`tel:${PHONE}`}>call</a> · <a href={`sms:${PHONE}`}>text</a> (587) 885-6499
          </p>
        </div>
      </div>

      <a href="#work" class="nv-c-hero__cue" aria-label="See recent work">
        <span class="nv-micro">See the work</span>
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M7 2v10M2.5 7.5 7 12l4.5-4.5" stroke="currentColor" stroke-width="1.2" />
        </svg>
      </a>
    </section>

    <!-- 2 · The work, swipeable -->
    <section class="nv-c-sec nv-c-sec--gallery" id="work" aria-label="Recent work">
      <div class="nv-c-col nv-c-gallery__head">
        <p class="nv-eyebrow">Recent work</p>
        <p class="nv-micro nv-c-gallery__count" aria-live="polite">
          <span data-gallery-index>1</span> / {photos.length}
        </p>
      </div>

      <div class="nv-c-gallery" data-gallery>
        <ul class="nv-c-gallery__track" data-gallery-track tabindex="0" aria-label="Swipe through photos">
          {
            photos.map((p, i) => (
              <li class="nv-c-gallery__slide">
                <img
                  src={photoSrc(p.file)}
                  alt={p.alt}
                  width="1620"
                  height="1080"
                  loading={i < 2 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </li>
            ))
          }
        </ul>
        <button class="nv-c-gallery__nav nv-c-gallery__nav--prev" data-gallery-prev aria-label="Previous photo">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M10 3 5 8l5 5" stroke="currentColor" stroke-width="1.4" /></svg>
        </button>
        <button class="nv-c-gallery__nav nv-c-gallery__nav--next" data-gallery-next aria-label="Next photo">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m6 3 5 5-5 5" stroke="currentColor" stroke-width="1.4" /></svg>
        </button>
      </div>
    </section>

    <!-- 3 · The one package to start with -->
    <section class="nv-c-sec">
      <div class="nv-c-col">
        <article class="nv-c-pkg nv-frame" data-reveal="up">
          <p class="nv-eyebrow nv-c-pkg__eyebrow">
            <FrameMark size={12} />
            <span>Essential Package</span>
          </p>

          <p class="nv-c-pkg__price">
            <span class="nv-micro">From</span>
            <span class="nv-c-pkg__num"><span class="nv-c-pkg__dollar">$</span>285</span>
            <span class="nv-micro">+ GST</span>
          </p>

          <p class="nv-body nv-c-pkg__blurb">
            Everything you need to launch on MLS and Realtor.ca.
          </p>

          <ul class="nv-c-pkg__list">
            {essential.map((f) => <li>{f}</li>)}
            <li class="nv-c-pkg__perk">Drone photos — <strong>free for First Place agents</strong></li>
          </ul>

          <a href={ORDER_URL} class="nv-btn nv-btn--solid nv-c-btn">
            <span>Book Online</span>
          </a>
          <p class="nv-c-quiet nv-c-pkg__fine">
            Mention “First Place” in your booking notes. Bigger listing?{' '}
            <a href="/pricing/">See all packages</a>
          </p>
        </article>
      </div>
    </section>

    <!-- 4 · Proof from their own office -->
    <section class="nv-c-sec">
      <div class="nv-c-col nv-c-quotes">
        {
          testimonials.map((t, i) => (
            <figure class="nv-c-quote" data-reveal="up" style={`--d:${i * 100}ms`}>
              <p class="nv-c-quote__stars" aria-label="Rated 5 out of 5">★★★★★</p>
              <blockquote class="nv-c-quote__text">“{t.quote}”</blockquote>
              <figcaption class="nv-c-quote__by">
                <img src={t.img} alt="" width="48" height="48" loading="lazy" />
                <span>
                  <span class="nv-c-quote__name">{t.name}</span>
                  <span class="nv-micro">First Place Realty</span>
                </span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </section>

    <!-- 5 · Close -->
    <section class="nv-c-sec nv-c-close">
      <div class="nv-c-col">
        <h2 class="nv-h2 nv-c-close__title" data-reveal="clip">
          Let's get your listings <span class="nv-accent-word">looking the part</span>.
        </h2>
        <div class="nv-c-close__actions" data-reveal="up" style="--d:120ms">
          <a href={ORDER_URL} class="nv-btn nv-btn--solid nv-c-btn">
            <span>Book Your First Shoot</span>
          </a>
          <p class="nv-c-quiet">
            Calgary · Airdrie · Cochrane · Chestermere · Okotoks
          </p>
        </div>
      </div>
    </section>
  </main>

  <footer class="nv-c-foot">
    <a href="/">northvantagemedia.com</a>
  </footer>

  <!-- Thumb-reach bar on phones; appears once the hero buttons scroll away -->
  <nav class="nv-c-dock" aria-label="Quick contact" data-dock>
    <a href={`tel:${PHONE}`}>Call</a>
    <a href={`sms:${PHONE}`}>Text</a>
    <a href={VCARD} download>Save Contact</a>
  </nav>

  <Motion />

  <script>
    // Gallery: counter + desktop arrows over a native scroll-snap track.
    const gallery = document.querySelector('[data-gallery]');
    const track = gallery && gallery.querySelector('[data-gallery-track]');
    const indexEl = document.querySelector('[data-gallery-index]');
    if (gallery && track) {
      const slides = [...track.children];
      const current = () => {
        const mid = track.scrollLeft + track.clientWidth / 2;
        let best = 0;
        slides.forEach((s, i) => {
          const c = s.offsetLeft + s.offsetWidth / 2;
          if (Math.abs(c - mid) < Math.abs(slides[best].offsetLeft + slides[best].offsetWidth / 2 - mid)) best = i;
        });
        return best;
      };
      const go = (i) => {
        const s = slides[Math.max(0, Math.min(slides.length - 1, i))];
        track.scrollTo({ left: s.offsetLeft - (track.clientWidth - s.offsetWidth) / 2, behavior: 'smooth' });
      };
      track.addEventListener('scroll', () => {
        if (indexEl) indexEl.textContent = String(current() + 1);
      }, { passive: true });
      gallery.querySelector('[data-gallery-prev]').addEventListener('click', () => go(current() - 1));
      gallery.querySelector('[data-gallery-next]').addEventListener('click', () => go(current() + 1));
    }

    // Dock: hidden while the hero's own buttons are on screen.
    const dock = document.querySelector('[data-dock]');
    const heroActions = document.getElementById('hero-actions');
    if (dock && heroActions && 'IntersectionObserver' in window) {
      new IntersectionObserver(([e]) => {
        dock.classList.toggle('is-shown', !e.isIntersecting && e.boundingClientRect.top < 0);
      }).observe(heroActions);
    }
  </script>

  <style>
    /* One narrow reading column; only the gallery runs wider. */
    .nv-c-col {
      width: 100%;
      max-width: 34rem;
      margin-inline: auto;
      padding-inline: 1.5rem;
    }

    .nv-c-btn {
      width: 100%;
      padding-block: 1.25rem;
      font-size: 0.8125rem;
    }

    .nv-c-quiet {
      margin: 0;
      font-size: 0.875rem;
      line-height: 1.6;
      color: rgb(243 239 231 / 0.55);
    }
    .nv-c-quiet a {
      color: var(--color-brand-text);
      text-decoration: underline;
      text-decoration-color: rgb(232 132 60 / 0.6);
      text-underline-offset: 3px;
    }

    .nv-c-sec {
      padding-block: clamp(4rem, 12vw, 6.5rem);
    }

    .nv-c-sec--gallery {
      padding-bottom: 0;
    }

    /* ── 1 · Hero ── */
    .nv-c-hero {
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-height: 100svh;
      padding-block: 3.5rem 5.5rem;
      overflow: clip;
    }
    .nv-c-hero__glow {
      position: absolute;
      inset: 0;
      z-index: -1;
      background:
        radial-gradient(90% 55% at 85% 0%, rgb(232 132 60 / 0.14), transparent 70%),
        linear-gradient(180deg, var(--color-brand-bg) 30%, var(--color-brand-primary));
    }
    .nv-c-hero__logo img {
      display: block;
      width: 56px;
      height: 56px;
    }
    .nv-c-hero__title {
      margin: 2.25rem 0 0;
      font-size: clamp(2.2rem, 9vw, 3.4rem);
    }
    .nv-c-hero__lead {
      margin: 1.25rem 0 0;
      max-width: 30ch;
    }
    .nv-c-hero__perk {
      margin: 0.75rem 0 0;
      font-size: clamp(1.0625rem, 1.35vw, 1.25rem);
      line-height: 1.5;
      font-weight: 500;
      color: var(--color-brand-accent);
    }
    .nv-c-hero__actions {
      display: grid;
      gap: 1.1rem;
      margin-top: 2.5rem;
      text-align: center;
    }
    .nv-c-hero__cue {
      position: absolute;
      left: 50%;
      bottom: 1.5rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      color: var(--color-brand-muted);
      text-decoration: none;
      transform: translateX(-50%);
    }

    /* ── 2 · Gallery ── */
    .nv-c-gallery__head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      margin-bottom: 1.25rem;
    }
    .nv-c-gallery__count {
      margin: 0;
    }
    .nv-c-gallery {
      position: relative;
      max-width: 72rem;
      margin-inline: auto;
    }
    .nv-c-gallery__track {
      --peek: 1.5rem;
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: calc(100% - var(--peek) * 2 - 0.75rem);
      gap: 0.75rem;
      margin: 0;
      padding: 0 var(--peek);
      list-style: none;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--peek);
      overscroll-behavior-x: contain;
      scrollbar-width: none;
    }
    .nv-c-gallery__track::-webkit-scrollbar {
      display: none;
    }
    .nv-c-gallery__slide {
      scroll-snap-align: center;
      aspect-ratio: 3 / 2;
      overflow: hidden;
      border-radius: 2px;
      background: var(--color-brand-surface);
    }
    .nv-c-gallery__slide img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    @media (min-width: 720px) {
      .nv-c-gallery__track {
        --peek: 3rem;
        grid-auto-columns: min(46rem, 70%);
      }
    }

    .nv-c-gallery__nav {
      display: none;
    }
    @media (hover: hover) and (min-width: 720px) {
      .nv-c-gallery__nav {
        position: absolute;
        top: 50%;
        display: grid;
        place-items: center;
        width: 48px;
        height: 48px;
        border: 1px solid var(--nv-hairline-strong);
        border-radius: 999px;
        background: rgb(10 14 23 / 0.7);
        backdrop-filter: blur(6px);
        color: var(--color-brand-text);
        cursor: pointer;
        transform: translateY(-50%);
        transition: border-color 0.4s var(--nv-ease);
      }
      .nv-c-gallery__nav:hover {
        border-color: var(--color-brand-accent);
      }
      .nv-c-gallery__nav--prev {
        left: 1rem;
      }
      .nv-c-gallery__nav--next {
        right: 1rem;
      }
    }

    /* ── 3 · Essential package ── */
    .nv-c-pkg {
      --nv-frame-size: 24px;
      --nv-frame-color: var(--color-brand-accent);
      padding: 2rem 1.5rem;
      background: var(--color-brand-surface);
      border: 1px solid var(--nv-hairline);
    }
    .nv-c-pkg__eyebrow {
      color: var(--color-brand-text);
    }
    .nv-c-pkg__eyebrow :global(.nv-mark) {
      color: var(--color-brand-accent);
    }
    .nv-c-pkg__price {
      display: flex;
      align-items: baseline;
      gap: 0.6rem;
      margin: 1.5rem 0 0;
    }
    .nv-c-pkg__num {
      font-family: var(--font-heading);
      font-weight: 250;
      font-size: 4rem;
      line-height: 0.9;
      letter-spacing: -0.05em;
      font-variant-numeric: tabular-nums;
    }
    .nv-c-pkg__dollar {
      font-size: 0.45em;
      vertical-align: 0.9em;
      color: var(--color-brand-accent);
    }
    .nv-c-pkg__blurb {
      margin: 1rem 0 0;
    }
    .nv-c-pkg__list {
      display: grid;
      gap: 0.85rem;
      margin: 1.75rem 0 2rem;
      padding: 1.5rem 0 0;
      border-top: 1px solid var(--nv-hairline);
      list-style: none;
      font-size: 0.975rem;
      color: rgb(243 239 231 / 0.8);
    }
    .nv-c-pkg__list li {
      position: relative;
      padding-left: 1.6rem;
    }
    .nv-c-pkg__list li::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0.45em;
      width: 0.7rem;
      height: 0.4rem;
      border-left: 1.5px solid var(--color-brand-accent);
      border-bottom: 1.5px solid var(--color-brand-accent);
      transform: rotate(-45deg);
    }
    .nv-c-pkg__perk strong {
      font-weight: 500;
      color: var(--color-brand-accent);
    }
    .nv-c-pkg__fine {
      margin-top: 1rem;
      text-align: center;
    }

    /* ── 4 · Testimonials ── */
    .nv-c-quotes {
      display: grid;
      gap: 3rem;
    }
    .nv-c-quote + .nv-c-quote {
      padding-top: 3rem;
      border-top: 1px solid var(--nv-hairline);
    }
    .nv-c-quote {
      margin: 0;
      text-align: center;
    }
    .nv-c-quote__stars {
      margin: 0;
      color: var(--color-brand-accent);
      letter-spacing: 0.3em;
      font-size: 0.85rem;
    }
    .nv-c-quote__text {
      margin: 1.25rem 0 0;
      font-family: var(--font-heading);
      font-weight: 300;
      font-size: clamp(1.4rem, 5.5vw, 1.85rem);
      line-height: 1.35;
      letter-spacing: -0.015em;
      color: var(--color-brand-text);
    }
    .nv-c-quote__by {
      display: inline-flex;
      align-items: center;
      gap: 0.85rem;
      margin-top: 1.75rem;
      text-align: left;
    }
    .nv-c-quote__by img {
      width: 48px;
      height: 48px;
      border-radius: 999px;
      object-fit: cover;
    }
    .nv-c-quote__by > span {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }
    .nv-c-quote__name {
      font-weight: 500;
    }

    /* ── 5 · Close ── */
    .nv-c-close {
      background: linear-gradient(180deg, var(--color-brand-bg), var(--color-brand-primary));
    }
    .nv-c-close__title {
      margin: 0;
      font-size: clamp(2rem, 8vw, 3rem);
    }
    .nv-c-close__actions {
      display: grid;
      gap: 1.1rem;
      margin-top: 2.25rem;
      text-align: center;
    }

    .nv-c-foot {
      padding: 2rem 1.5rem calc(5rem + env(safe-area-inset-bottom));
      background: var(--color-brand-primary);
      text-align: center;
    }
    .nv-c-foot a {
      font-size: 0.75rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--color-brand-muted);
      text-decoration: none;
    }

    /* ── Dock ── */
    .nv-c-dock {
      position: fixed;
      inset: auto 0 0 0;
      z-index: 60;
      display: grid;
      grid-template-columns: 1fr 1fr 1.4fr;
      background: rgb(10 14 23 / 0.94);
      backdrop-filter: blur(10px);
      border-top: 1px solid var(--nv-hairline-strong);
      padding-bottom: env(safe-area-inset-bottom);
      transform: translateY(105%);
      transition: transform 0.5s var(--nv-ease);
    }
    .nv-c-dock.is-shown {
      transform: none;
    }
    .nv-c-dock a {
      padding: 1.1rem 0.5rem;
      text-align: center;
      font-size: 0.75rem;
      font-weight: 500;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--color-brand-text);
      text-decoration: none;
    }
    .nv-c-dock a + a {
      border-left: 1px solid var(--nv-hairline);
    }
    .nv-c-dock a:last-child {
      background: var(--color-brand-accent);
      color: #0a0e17;
    }
    @media (min-width: 720px) {
      .nv-c-dock {
        display: none;
      }
      .nv-c-foot {
        padding-bottom: 2rem;
      }
    }
  </style>
</Layout>
