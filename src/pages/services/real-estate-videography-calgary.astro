---
import Layout from '../../layouts/Layout.astro';
import { breadcrumbs, service } from '../../lib/schema';
import Styles from '../../components/direction-1/Styles.astro';
import Nav from '../../components/direction-1/Nav.astro';
import Motion from '../../components/direction-1/Motion.astro';
import Footer from '../../components/direction-1/Footer.astro';
import FinalCta from '../../components/direction-1/FinalCta.astro';
import ServiceArea from '../../components/direction-1/ServiceArea.astro';
import Eyebrow from '../../components/direction-1/Eyebrow.astro';
import FrameMark from '../../components/direction-1/FrameMark.astro';
import PriceIcon from '../../components/direction-1/pricing/PriceIcon.astro';

const overviewFeatures = [
  { name: 'Sells The Listing Faster', copy: 'Compelling video puts more eyes on a listing, faster — more showings, more offers, and less time sitting on the market.' },
  { name: 'Builds Your Personal Brand', copy: 'Every video is shot and cut to make you look like the agent buyers and sellers want to work with — not just another name on a sign.' },
  { name: 'Wins You More Referrals', copy: 'A fast, full-price sale makes a client a fan. Great content is how one listing turns into the next five.' },
  { name: '3-Day Delivery', copy: 'A finished, download-ready edit lands in your inbox within 3 days of the shoot — ready to post or upload immediately.' },
];

// Video sets. Each item takes a `youtubeId` or an embed `src`; an item with
// neither renders as a placeholder tile.
const reels = [
  { label: 'Property Reel 01', src: 'https://iframe.mediadelivery.net/embed/469110/a398883b-93b3-4fc5-a769-2f53e5a536a7?autoplay=true&loop=false&muted=true&preload=false&responsive=true' },
  { label: 'Property Reel 02', src: 'https://iframe.mediadelivery.net/embed/469110/5e262981-3ef2-4357-ac91-73686c3c08f2?autoplay=true&loop=false&muted=true&preload=false&responsive=true' },
  { label: 'Property Reel 03', src: 'https://iframe.mediadelivery.net/embed/469110/ab02e49c-ec76-4177-9b6e-b69d7df60512?autoplay=true&loop=false&muted=true&preload=false&responsive=true' },
  { label: 'Property Reel 04', src: 'https://iframe.mediadelivery.net/embed/469110/cd183067-e645-4ff6-9cc2-313b89f6e251?autoplay=true&loop=false&muted=true&preload=false&responsive=true' },
  { label: 'Property Reel 05', src: 'https://iframe.mediadelivery.net/embed/469110/415bc110-011a-46c5-8cb8-daaac92ab4e9?autoplay=true&loop=false&muted=true&preload=false&responsive=true' },
  { label: 'Property Reel 06', src: 'https://iframe.mediadelivery.net/embed/469110/8a0f9314-e6dc-4a8b-874b-f0f92380495a?autoplay=true&loop=false&muted=true&preload=false&responsive=true' },
];

const cinematic = [
  { label: 'Greenwich — Cinematic Showcase', youtubeId: 'gyvaricJimI' },
  { label: 'Cinematic Showcase 02', youtubeId: 'tZ1Q5klP3Zo' },
];

const agentVideos = [
  { label: 'Agent Branding 01', src: 'https://iframe.mediadelivery.net/embed/469110/8d7fabda-f5bb-4b4e-a936-095c86900a4d?autoplay=true&loop=false&muted=true&preload=false&responsive=true' },
  { label: 'Agent Branding 02', src: 'https://iframe.mediadelivery.net/embed/469110/4c5e182c-a96c-4f80-ab99-d2992bc13e42?autoplay=true&loop=false&muted=true&preload=false&responsive=true' },
];

const steps = [
  { n: '01', title: 'Book', copy: 'Pick a time that works for you, we confirm the type of video and details in advance, and prepare a script tailored to your style.' },
  { n: '02', title: 'Shoot', copy: 'We arrive on site, and create a cinematic showing of the property and coach you through your lines. Expect 1 to 2 hours on site.' },
  { n: '03', title: 'Launch', copy: 'Within 3 days you have a professional polished video ready to post while your listing is generating buzz.' },
];

const pricing = [
  {
    icon: 'video',
    name: 'Social Media Property Reel',
    price: '499',
    featured: false,
    items: ['30–45 second vertical video', 'Custom script + on-camera coaching', 'Edited for Reels, TikTok & Facebook'],
  },
  {
    icon: 'showcase',
    name: 'Cinematic Property Showcase',
    price: '499',
    featured: true,
    items: ['60–90 second horizontal walkthrough', 'Professional color grade + music', 'Perfect for MLS, YouTube & buyers'],
  },
  {
    icon: 'agent',
    name: 'Agent Branding Videos',
    price: '399',
    featured: false,
    items: ['30–40 second vertical video', 'Scripted around you, not the listing', '4-video package from $1,199'],
  },
];

const faqs = [
  {
    q: 'Do you shoot both vertical and horizontal video?',
    a: 'Yes. Social Media Property Reels and Agent Branding Videos are shot and edited vertical (9:16) for Reels, TikTok, and Stories. The Cinematic Property Showcase is shot and edited horizontal (16:9) for MLS, YouTube, and sharing directly with buyers.',
  },
  {
    q: 'Is drone footage included?',
    a: 'Aerial footage can be woven directly into your Cinematic Property Showcase, or booked on its own or bundled with photos through our Drone Photography & Video service.',
  },
  {
    q: 'How long does a video shoot take?',
    a: 'Most shoots run 1–2 hours on site, depending on the property size and how many video types you’re booking together.',
  },
  {
    q: 'Will I be on camera?',
    a: 'It’s optional. Social Media Property Reels and Agent Branding Videos both include on-camera coaching if you want to appear — or we can shoot the property and script a voiceover instead.',
  },
  {
    q: 'How is the video delivered?',
    a: 'Every video is delivered as a downloadable MP4 file via a link to your email, ready to post or upload — no watermark, no compression loss.',
  },
];

const pageSchema = [
  service({
    path: '/services/real-estate-videography-calgary/',
    name: 'Calgary Real Estate Videography',
    serviceType: 'Real estate video production',
    description: 'Vertical social media property reels, cinematic property showcases, and agent branding videos for Calgary real estate agents.'
  }),
  breadcrumbs([{ name: 'Videography', path: '/services/real-estate-videography-calgary/' }]),
];
---

<Layout
  title="Calgary Real Estate Videography — Northvantage Media"
  description="Calgary real estate video production: vertical Social Media Property Reels, horizontal Cinematic Property Showcases, and Agent Branding Videos. Built to sell listings faster, with 3-day delivery."
  schema={pageSchema}
>
  <Styles />

  <div class="nv-grain" aria-hidden="true"></div>

  <Nav />

  <main>
    <!-- Hero -->
    <section class="nv-vidhero">
      <div class="nv-vidhero__media" data-parallax="0.1">
        <img
          src="/images/real-estate-photography/image-02.jpg"
          alt="Aerial view of downtown Calgary and the Bow River at golden hour"
          width="1000"
          height="571"
          fetchpriority="high"
        />
        <div class="nv-vidhero__scrim" aria-hidden="true"></div>
      </div>

      <div class="nv-wrap nv-vidhero__body">
        <p class="nv-eyebrow" data-reveal="fade">
          <FrameMark size={12} float />
          <span>Real Estate Videography</span>
        </p>

        <h1 class="nv-h2 nv-vidhero__title" data-reveal="clip">
          Calgary Real Estate <span class="nv-accent-word">Video</span> Production
        </h1>

        <p class="nv-lead nv-vidhero__lead" data-reveal="up" style="--d:120ms">
          Vertical reels for the feed, cinematic walkthroughs for the
          listing, and branding videos that turn you into the agent buyers
          already trust — shot, edited, and delivered in days.
        </p>

        <ul class="nv-vidhero__proof" data-reveal="up" style="--d:200ms">
          <li><span class="nv-micro">Starting at $399</span></li>
          <li><span class="nv-micro">Vertical &amp; Horizontal</span></li>
          <li><span class="nv-micro">3-Day Delivery</span></li>
        </ul>

        <div class="nv-vidhero__ctas" data-reveal="up" style="--d:260ms">
          <a href="#pricing" class="nv-btn nv-btn--solid">
            <span>See Packages and Pricing</span>
            <FrameMark size={11} dot={false} />
          </a>
          <a href="https://northvantagemedia.hd.pics/order" class="nv-btn nv-btn--line">
            <span>Book Online</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Overview -->
    <section class="nv-section nv-vidov" id="overview">
      <div class="nv-wrap nv-vidov__grid">
        <div class="nv-vidov__aside">
          <Eyebrow>Every Day Matters</Eyebrow>
          <h2 class="nv-h2 nv-vidov__title" data-reveal="clip">
            Spark A Bidding War, Not A <span class="nv-accent-word">Price Cut</span>
          </h2>

          <p class="nv-body nv-vidov__copy" data-reveal="up" style="--d:100ms">
            Every day a listing sits on the market costs your client money.
            Mortgage payments, taxes, insurance, and the stress of waiting
            add up. Worse, the longer it sits, the more likely they'll have
            to cut the price. Faster sales mean full asking price (or
            higher), happier clients, and more referrals coming your way.
          </p>
          <p class="nv-body nv-vidov__copy" data-reveal="up" style="--d:150ms">
            For real estate agents, compelling media is the difference
            between a listing sitting on the market or sparking a bidding
            war. Great content attracts higher-quality buyers, keeps
            property owners happy, and gives you a competitive edge over
            every other agent in your market.
          </p>
        </div>

        <div class="nv-vidov__main">
          <ul class="nv-vidov__list">
            {
              overviewFeatures.map((f, i) => (
                <li class="nv-vidov__item" data-reveal="up" style={`--d:${i * 90}ms`}>
                  <span class="nv-vidov__mark">
                    <FrameMark size={18} dot={false} />
                  </span>
                  <h3 class="nv-h3 nv-vidov__name">{f.name}</h3>
                  <p class="nv-vidov__copy2">{f.copy}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- Social Media Property Reels -->
    <section class="nv-section nv-vidcat nv-vidcat--reels" id="reels">
      <div class="nv-wrap">
        <header class="nv-vidcat__head">
          <Eyebrow>Vertical &amp; Built for the Feed</Eyebrow>
          <h2 class="nv-h2 nv-vidcat__title" data-reveal="clip">
            Social Media <span class="nv-accent-word">Property Reels</span>
          </h2>
          <p class="nv-body nv-vidcat__copy" data-reveal="up" style="--d:100ms">
            A 30–45 second vertical video built to stop the scroll —
            fast-paced, music-driven, and edited specifically for Instagram
            and Facebook Reels. Includes a custom script and personalized
            on-camera coaching so you show up confident every time.
          </p>
          <ul class="nv-vidcat__list" data-reveal="up" style="--d:150ms">
            <li><FrameMark size={10} dot={false} /><span>Custom script written for the property and for you</span></li>
            <li><FrameMark size={10} dot={false} /><span>On-camera coaching, or we shoot property-only</span></li>
            <li><FrameMark size={10} dot={false} /><span>Fast-paced edit built to stop the scroll</span></li>
          </ul>
        </header>

        <div class="nv-vidgrid nv-vidgrid--vert">
          {
            reels.map((r, i) => (
              <div class="nv-vidbox nv-frame nv-frame--hover" data-reveal="up" style={`--d:${i * 70}ms`}>
                <div class="nv-vidbox__inner nv-vidbox__inner--vert">
                  {r.src ? (
                    <iframe
                      src={r.src}
                      title={r.label}
                      loading="lazy"
                      allow="accelerometer;gyroscope;autoplay;encrypted-media;picture-in-picture;fullscreen"
                      allowfullscreen
                    />
                  ) : r.youtubeId ? (
                    <iframe
                      src={`https://www.youtube.com/embed/${r.youtubeId}`}
                      title={r.label}
                      loading="lazy"
                      allow="accelerometer;gyroscope;autoplay;encrypted-media;picture-in-picture;fullscreen"
                      allowfullscreen
                    />
                  ) : (
                    <div class="nv-vidph">
                      <span class="nv-vidph__play" aria-hidden="true">
                        <svg viewBox="0 0 20 20" fill="none">
                          <path d="M7.5 5.5v9l7-4.5z" fill="currentColor" />
                        </svg>
                      </span>
                      <span class="nv-vidph__label">{r.label}</span>
                    </div>
                  )}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Cinematic Property Showcase -->
    <section class="nv-section nv-vidcat nv-vidcat--feature" id="cinematic">
      <div class="nv-wrap">
        <header class="nv-vidcat__head">
          <Eyebrow>Horizontal &amp; Built to Sell</Eyebrow>
          <h2 class="nv-h2 nv-vidcat__title" data-reveal="clip">
            Cinematic <span class="nv-accent-word">Property Showcase</span>
          </h2>
          <p class="nv-body nv-vidcat__copy" data-reveal="up" style="--d:100ms">
            A 60–90 second horizontal walkthrough of the property,
            professionally edited with music and color grade. Perfect for
            MLS, YouTube, or sharing directly with buyers.
          </p>
          <ul class="nv-vidcat__list" data-reveal="up" style="--d:150ms">
            <li><FrameMark size={10} dot={false} /><span>Full interior + exterior walkthrough</span></li>
            <li><FrameMark size={10} dot={false} /><span>Drone footage woven into the edit</span></li>
            <li><FrameMark size={10} dot={false} /><span>Professionally graded and paced to keep buyers watching</span></li>
          </ul>
        </header>

        <div class="nv-vidgrid nv-vidgrid--horiz nv-vidgrid--two">
          {
            cinematic.map((c, i) => (
              <div class="nv-vidbox nv-frame nv-frame--hover" data-reveal="up" style={`--d:${i * 90}ms`}>
                <div class="nv-vidbox__inner nv-vidbox__inner--horiz">
                  {c.youtubeId ? (
                    <iframe
                      src={`https://www.youtube.com/embed/${c.youtubeId}`}
                      title={c.label}
                      loading="lazy"
                      allow="accelerometer;gyroscope;autoplay;encrypted-media;picture-in-picture;fullscreen"
                      allowfullscreen
                    />
                  ) : (
                    <div class="nv-vidph">
                      <span class="nv-vidph__play" aria-hidden="true">
                        <svg viewBox="0 0 20 20" fill="none">
                          <path d="M7.5 5.5v9l7-4.5z" fill="currentColor" />
                        </svg>
                      </span>
                      <span class="nv-vidph__label">{c.label}</span>
                    </div>
                  )}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Agent Branding Videos -->
    <section class="nv-section nv-vidcat nv-vidcat--agent" id="agent-branding">
      <div class="nv-wrap">
        <header class="nv-vidcat__head">
          <Eyebrow>Build Your Personal Brand</Eyebrow>
          <h2 class="nv-h2 nv-vidcat__title" data-reveal="clip">
            Agent <span class="nv-accent-word">Branding Videos</span>
          </h2>
          <p class="nv-body nv-vidcat__copy" data-reveal="up" style="--d:100ms">
            A 30–40 second vertical video built around you, not a
            listing — professionally scripted and edited to position you as
            the trusted expert in your market.
          </p>
          <ul class="nv-vidcat__list" data-reveal="up" style="--d:150ms">
            <li><FrameMark size={10} dot={false} /><span>Positions you as the go-to expert, not just another agent</span></li>
            <li><FrameMark size={10} dot={false} /><span>Great for market updates, tips, and introductions</span></li>
            <li><FrameMark size={10} dot={false} /><span>4-video package covers a full month of content</span></li>
          </ul>
        </header>

        <div class="nv-vidgrid nv-vidgrid--vert nv-vidgrid--three nv-vidgrid--two">
          {
            agentVideos.map((a, i) => (
              <div class="nv-vidbox nv-frame nv-frame--hover" data-reveal="up" style={`--d:${i * 90}ms`}>
                <div class="nv-vidbox__inner nv-vidbox__inner--vert">
                  {a.src ? (
                    <iframe
                      src={a.src}
                      title={a.label}
                      loading="lazy"
                      allow="accelerometer;gyroscope;autoplay;encrypted-media;picture-in-picture;fullscreen"
                      allowfullscreen
                    />
                  ) : a.youtubeId ? (
                    <iframe
                      src={`https://www.youtube.com/embed/${a.youtubeId}`}
                      title={a.label}
                      loading="lazy"
                      allow="accelerometer;gyroscope;autoplay;encrypted-media;picture-in-picture;fullscreen"
                      allowfullscreen
                    />
                  ) : (
                    <div class="nv-vidph">
                      <span class="nv-vidph__play" aria-hidden="true">
                        <svg viewBox="0 0 20 20" fill="none">
                          <path d="M7.5 5.5v9l7-4.5z" fill="currentColor" />
                        </svg>
                      </span>
                      <span class="nv-vidph__label">{a.label}</span>
                    </div>
                  )}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- How It Works -->
    <section class="nv-section nv-vidhow" id="how-it-works">
      <div class="nv-wrap">
        <header class="nv-vidhow__head">
          <Eyebrow>Process</Eyebrow>
          <h2 class="nv-h2 nv-vidhow__title" data-reveal="clip">How It Works</h2>
        </header>

        <ol class="nv-vidhow__list">
          {
            steps.map((s, i) => (
              <li class="nv-vidhow__item" data-reveal="up" style={`--d:${i * 100}ms`}>
                <span class="nv-vidhow__n">{s.n}</span>
                <h3 class="nv-h3 nv-vidhow__title2">{s.title}</h3>
                <p class="nv-vidhow__copy">{s.copy}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- Pricing -->
    <section class="nv-section nv-vidprice" id="pricing">
      <div class="nv-wrap">
        <header class="nv-vidprice__head">
          <Eyebrow>Packages</Eyebrow>
          <h2 class="nv-h2 nv-vidprice__title" data-reveal="clip">Videography Pricing</h2>
          <p class="nv-body nv-vidprice__copy" data-reveal="up" style="--d:100ms">
            Book a single video type or bundle them with photography.
            GST additional.
          </p>
        </header>

        <div class="nv-vidprice__grid">
          {
            pricing.map((p, i) => (
              <div
                class:list={['nv-vidpkg', p.featured && 'nv-vidpkg--featured', 'nv-frame', p.featured && 'nv-frame--hover']}
                data-reveal="up"
                style={`--d:${i * 110}ms`}
              >
                <div class="nv-vidpkg__top">
                  <span class="nv-vidpkg__icon">
                    <PriceIcon name={p.icon} size={26} />
                  </span>
                  <h3 class="nv-h3 nv-vidpkg__name">
                    {p.name}
                    {p.featured && (
                      <span class="nv-vidpkg__tag">
                        <FrameMark size={9} dot={false} />
                        Most Popular
                      </span>
                    )}
                  </h3>
                  <p class="nv-vidpkg__price">
                    <span class="nv-vidpkg__dollar">$</span>
                    {p.price}
                    <span class="nv-vidpkg__gst">+GST</span>
                  </p>
                </div>
                <ul class="nv-vidpkg__list">
                  {p.items.map((item) => (
                    <li>
                      <FrameMark size={9} dot={false} />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>

        <div class="nv-vidprice__ctas" data-reveal="up" style="--d:340ms">
          <a href="https://northvantagemedia.hd.pics/order" class="nv-btn nv-btn--solid">
            <span>Book Online</span>
            <FrameMark size={11} dot={false} />
          </a>
          <a href="/pricing" class="nv-btn nv-btn--line"><span>See All Packages and Pricing</span></a>
        </div>
      </div>
    </section>

    <!-- Cross-sell -->
    <section class="nv-section nv-vidcross">
      <div class="nv-wrap nv-vidcross__inner">
        <p class="nv-body nv-vidcross__copy">
          Need listing photos too?
        </p>
        <a href="/services/real-estate-photography-calgary" class="nv-link">
          <span>See Our Real Estate Photography Service</span>
          <span class="nv-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <ServiceArea />

    <!-- FAQ -->
    <section class="nv-section nv-vidfaq" id="faq">
      <div class="nv-wrap nv-vidfaq__grid">
        <div class="nv-vidfaq__aside">
          <Eyebrow>Common Questions</Eyebrow>
          <h2 class="nv-h2 nv-vidfaq__title" data-reveal="clip">
            Frequently Asked <span class="nv-accent-word">Questions</span>
          </h2>
        </div>

        <div class="nv-vidfaq__list">
          {
            faqs.map((f, i) => (
              <details class="nv-vidfaq__item" data-reveal="up" style={`--d:${Math.min(i, 6) * 60}ms`}>
                <summary class="nv-vidfaq__q">
                  <span>{f.q}</span>
                  <span class="nv-vidfaq__icon" aria-hidden="true"></span>
                </summary>
                <p class="nv-vidfaq__a">{f.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <FinalCta />
  </main>

  <Footer />

  <Motion />

  <style>
    /* ── Hero ── */
    .nv-vidhero {
      position: relative;
      overflow: clip;
      padding-top: clamp(9rem, 16vw, 12rem);
      padding-bottom: clamp(3.5rem, 7vw, 6rem);
    }
    .nv-vidhero__media {
      position: absolute;
      inset: -8% 0 -8% 0;
      z-index: -1;
      transform: translate3d(0, var(--py, 0px), 0);
    }
    .nv-vidhero__media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 50% 45%;
      filter: saturate(0.95) contrast(1.06) brightness(0.55);
    }
    .nv-vidhero__scrim {
      position: absolute;
      inset: 0;
      background:
        linear-gradient(
          to top,
          var(--color-brand-bg) 4%,
          rgb(10 14 23 / 0.86) 46%,
          rgb(10 14 23 / 0.55) 100%
        ),
        linear-gradient(
          to right,
          rgb(10 14 23 / 0.55) 0%,
          rgb(10 14 23 / 0.1) 60%,
          transparent 100%
        );
    }
    .nv-vidhero__body {
      position: relative;
    }
    .nv-vidhero__title {
      margin: clamp(1.1rem, 2vw, 1.6rem) 0 0;
      max-width: 20ch;
    }
    .nv-vidhero__lead {
      margin: clamp(1.5rem, 2.6vw, 2rem) 0 0;
      max-width: 56ch;
    }
    .nv-vidhero__proof {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem 1.4rem;
      margin: clamp(1.75rem, 3vw, 2.25rem) 0 0;
      padding: 0;
      list-style: none;
    }
    .nv-vidhero__proof li {
      position: relative;
    }
    .nv-vidhero__proof li + li::before {
      content: '';
      position: absolute;
      left: -0.75rem;
      top: 50%;
      width: 3px;
      height: 3px;
      background: var(--color-brand-accent);
      transform: translateY(-50%);
    }
    .nv-vidhero__ctas {
      display: flex;
      flex-wrap: wrap;
      gap: 0.85rem;
      margin-top: clamp(2rem, 3.5vw, 2.75rem);
    }

    /* ── Overview ── */
    .nv-vidov {
      background: var(--color-brand-bg);
    }
    .nv-vidov__grid {
      display: grid;
      gap: clamp(2.75rem, 6vw, 5rem);
    }
    @media (min-width: 1000px) {
      .nv-vidov__grid {
        grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
        gap: clamp(3rem, 7vw, 6rem);
        align-items: start;
      }
      .nv-vidov__aside {
        position: sticky;
        top: 8rem;
      }
    }
    .nv-vidov__title {
