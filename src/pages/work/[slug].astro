---
/**
 * /work/<slug>/ — a real listing laid out deliverable by deliverable.
 * Written for agents, not buyers: no property specs, just "here is
 * everything this package produced." Content lives in src/data/work.ts.
 */
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { breadcrumbs } from '../../lib/schema';
import { work, type WorkListing, type WorkPhoto } from '../../data/work';
import Styles from '../../components/direction-1/Styles.astro';
import Nav from '../../components/direction-1/Nav.astro';
import Motion from '../../components/direction-1/Motion.astro';
import Footer from '../../components/direction-1/Footer.astro';
import FinalCta from '../../components/direction-1/FinalCta.astro';
import FrameMark from '../../components/direction-1/FrameMark.astro';
import BunnyVideo from '../../components/direction-1/BunnyVideo.astro';
import Lightbox from '../../components/direction-1/Lightbox.astro';

export function getStaticPaths() {
  return work.map((listing) => ({ params: { slug: listing.slug }, props: { listing } }));
}

interface Props {
  listing: WorkListing;
}

const { listing } = Astro.props;

const BOOKING_URL = 'https://northvantagemedia.hd.pics/order';

const assets = import.meta.glob<{ default: ImageMetadata }>('/src/assets/work/**/*.{jpg,jpeg,png}', {
  eager: true,
});
function img(folder: string, file: string): ImageMetadata {
  const mod = assets[`/src/assets/work/${listing.slug}/${folder}/${file}`];
  if (!mod) throw new Error(`Missing work image: ${listing.slug}/${folder}/${file}`);
  return mod.default;
}

// Grids load small thumbnails (800px max, 1280px for wide shots) so a big
// gallery stays light; the full-size WebP only loads when a photo is opened.
const THUMB = [400, 640, 800];
const THUMB_WIDE = [800, 1280];
const THUMB_QUALITY = 70;

// Each photo gets a grid thumbnail plus a full-size WebP for the lightbox.
async function withFull(folder: string, photos: WorkPhoto[]) {
  return Promise.all(
    photos.map(async (p) => {
      const src = img(folder, p.file);
      const full = await getImage({ src, width: 2000, format: 'webp', quality: 82 });
      return { ...p, src, full: full.src };
    })
  );
}

const photos = await withFull('photos', listing.photos);
const drone = await withFull('drone', listing.drone ?? []);
const plans = await withFull(
  'plans',
  (listing.floorplans ?? []).map((f) => ({ file: f.file, caption: f.label }))
);
const hero = img('photos', listing.hero);
const heroCaption = listing.photos.find((p) => p.file === listing.hero)?.caption ?? listing.address;
const screenshot = listing.website && img('website', listing.website!.screenshot);
const share = await getImage({ src: hero, width: 1620, height: 1080, format: 'jpg' });

// The "what's included" list, the section numbers and the CTA/meta copy all
// come from this one list, so a listing without a deliverable just drops it.
type KitItem = { id: string; name: string; note: string; short: string };
const kit = [
  listing.reel && { id: 'reel', name: 'Social Media Reel', note: 'Vertical, 9:16', short: 'reel' },
  listing.youtubeId && { id: 'video', name: 'Cinematic Video', note: 'Horizontal, 16:9', short: 'cinematic video' },
  { id: 'photos', name: 'HDR Photos', note: `${photos.length} images`, short: 'photos' },
  drone.length > 0 && { id: 'drone', name: 'Drone Photos', note: `${drone.length} aerials`, short: 'drone' },
  listing.website && { id: 'website', name: 'Property Website', note: 'Single-listing site', short: 'a property website' },
  plans.length > 0 && { id: 'floor-plans', name: 'Floor Plans', note: `${plans.length} levels + RMS`, short: 'floor plans' },
  listing.iguide && { id: 'iguide', name: 'iGuide 3D Tour', note: 'Self-guided', short: 'a 3D tour' },
].filter((k): k is KitItem => Boolean(k));
const has = (id: string) => kit.some((k) => k.id === id);
const num = (id: string) => String(kit.findIndex((k) => k.id === id) + 1).padStart(2, '0');
const shorts = kit.map((k) => k.short);
const kitSentence = shorts.length > 1 ? `${shorts.slice(0, -1).join(', ')} and ${shorts.at(-1)}` : shorts[0];

const path = `/work/${listing.slug}/`;
const pageSchema = [breadcrumbs([{ name: listing.address, path }])];
---

<Layout
  title={`${listing.address}: ${listing.packageName} — Northvantage Media`}
  description={`Everything one ${listing.packageName} shoot delivered for ${listing.address} in ${listing.city}: ${kitSentence.replace('photos', `${photos.length} photos`)}.`}
  image={share.src}
  imageAlt={`${listing.address}, ${listing.city}: ${heroCaption.toLowerCase()}`}
  schema={pageSchema}
>
  <Styles />

  <div class="nv-grain" aria-hidden="true"></div>

  <Nav />

  <main>
    <!-- Hero -->
    <section class="nv-wk-hero">
      <div class="nv-wk-hero__media" data-parallax="0.1">
        <Image
          src={hero}
          alt={`${listing.address}: ${heroCaption.toLowerCase()}`}
          widths={[960, 1600, 2000]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
        />
        <div class="nv-wk-hero__scrim" aria-hidden="true"></div>
      </div>

      <div class="nv-wrap nv-wk-hero__body">
        <p class="nv-eyebrow" data-reveal="fade">
          <FrameMark size={12} float />
          <span>{listing.packageName} · Case Study</span>
        </p>

        <h1 class="nv-display nv-wk-hero__title" data-reveal="clip">
          {listing.address.split(' ').slice(0, -1).join(' ')}{' '}
          <span class="nv-accent-word">{listing.address.split(' ').at(-1)}</span>
        </h1>

        <p class="nv-micro nv-wk-hero__meta" data-reveal="up" style="--d:120ms">
          <span>{listing.city}</span>
          <span>
            Shot for <a href={listing.agent.url} target="_blank" rel="noopener">{listing.agent.name}</a>
          </span>
        </p>
      </div>
    </section>

    <!-- What the package produced -->
    <section class="nv-section nv-wk-intro">
      <div class="nv-wrap nv-wk-intro__grid">
        <div>
          <p class="nv-eyebrow" data-reveal="fade">
            <FrameMark size={12} />
            <span>The Listing</span>
          </p>
          <p class="nv-lead nv-wk-intro__copy" data-reveal="up">{listing.summary}</p>
          <p class="nv-body nv-wk-intro__copy" data-reveal="up" style="--d:80ms">
            Below is everything the {listing.packageName} delivered for it, from one
            booking. Scroll through, or jump to the piece you care about.
          </p>
        </div>

        <ol class="nv-wk-kit" aria-label="What's included">
          {
            kit.map((k, i) => (
              <li data-reveal="up" style={`--d:${i * 60}ms`}>
                <a href={`#${k.id}`} class="nv-wk-kit__row">
                  <span class="nv-micro nv-wk-kit__n">{String(i + 1).padStart(2, '0')}</span>
                  <span class="nv-wk-kit__name">{k.name}</span>
                  <span class="nv-micro nv-wk-kit__note">{k.note}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- 01 Reel -->
    {has('reel') && (
      <section class="nv-section nv-wk-sec" id="reel">
        <div class="nv-wrap nv-wk-reel">
          <header class="nv-wk-head">
            <p class="nv-micro nv-wk-head__n">{num('reel')}</p>
            <h2 class="nv-h2" data-reveal="clip">Social Media <span class="nv-accent-word">Reel</span></h2>
            <p class="nv-body nv-wk-head__copy" data-reveal="up" style="--d:100ms">
              {listing.reel!.copy}
            </p>
            {listing.reel!.result && (
              <p class="nv-wk-stat" data-reveal="up" style="--d:160ms">
                <span class="nv-wk-stat__value">{listing.reel!.result.value}</span>
                <span class="nv-micro nv-wk-stat__label">{listing.reel!.result.label}</span>
              </p>
            )}
          </header>
          <div class="nv-wk-reel__video nv-frame nv-frame--hover" data-reveal="up">
            <div class="nv-wk-ratio nv-wk-ratio--vert">
              <BunnyVideo src={listing.reel!.src} title={`${listing.address} property reel`} />
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- 02 Cinematic video -->
    {has('video') && (
      <section class="nv-section nv-wk-sec" id="video">
        <div class="nv-wrap">
          <header class="nv-wk-head nv-wk-head--row">
            <p class="nv-micro nv-wk-head__n">{num('video')}</p>
            <h2 class="nv-h2" data-reveal="clip">Cinematic <span class="nv-accent-word">Property Video</span></h2>
            <p class="nv-body nv-wk-head__copy" data-reveal="up" style="--d:100ms">
              The full walkthrough: interior, exterior and drone footage, color graded and cut
              to music. Made for MLS, YouTube, and sending straight to buyers.
            </p>
          </header>
          <div class="nv-frame nv-frame--hover" data-reveal="up">
            <div class="nv-wk-ratio nv-wk-ratio--horiz">
              <iframe
                src={`https://www.youtube.com/embed/${listing.youtubeId}?rel=0`}
                title={`${listing.address} cinematic property video`}
                loading="lazy"
                allow="accelerometer;gyroscope;autoplay;encrypted-media;picture-in-picture;fullscreen"
                allowfullscreen
              />
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- 03 Photos -->
    <section class="nv-section nv-wk-sec" id="photos">
      <div class="nv-wrap">
        <header class="nv-wk-head nv-wk-head--row">
          <p class="nv-micro nv-wk-head__n">{num('photos')}</p>
          <h2 class="nv-h2" data-reveal="clip">
            {photos.length} <span class="nv-accent-word">HDR Photos</span>
          </h2>
          <p class="nv-body nv-wk-head__copy" data-reveal="up" style="--d:100ms">
            The complete set, edited and delivered next day. {listing.photosNote} Tap any photo
            to see it full size.
          </p>
        </header>
        <ul class="nv-wk-grid" data-lightbox-group>
          {
            photos.map((p, i) => (
              <li class:list={['nv-wk-grid__item', { 'is-wide': p.wide }]}>
                <a href={p.full} class="nv-wk-shot" data-lightbox data-caption={p.caption}>
                  <Image
                    src={p.src}
                    alt={p.caption}
                    widths={p.wide ? THUMB_WIDE : THUMB}
                    quality={THUMB_QUALITY}
                    sizes={p.wide ? '(min-width: 1440px) 1300px, 100vw' : '(min-width: 1440px) 650px, (min-width: 700px) 50vw, 100vw'}
                    loading={i < 2 ? 'eager' : 'lazy'}
                  />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- 04 Drone -->
    {has('drone') && (
      <section class="nv-section nv-wk-sec" id="drone">
        <div class="nv-wrap">
          <header class="nv-wk-head nv-wk-head--row">
            <p class="nv-micro nv-wk-head__n">{num('drone')}</p>
            <h2 class="nv-h2" data-reveal="clip">Drone <span class="nv-accent-word">Photos</span></h2>
            <p class="nv-body nv-wk-head__copy" data-reveal="up" style="--d:100ms">
              Aerials that show what ground shots can't: the lot, the green space behind it, and
              where the home sits in the community, with the property pinned so buyers find it
              instantly.
            </p>
          </header>
          <ul class="nv-wk-grid nv-wk-grid--drone" data-lightbox-group>
            {
              drone.map((p) => (
                <li class="nv-wk-grid__item">
                  <a href={p.full} class="nv-wk-shot" data-lightbox data-caption={p.caption}>
                    <Image
                      src={p.src}
                      alt={p.caption}
                      widths={THUMB}
                      quality={THUMB_QUALITY}
                      sizes="(min-width: 1440px) 650px, (min-width: 700px) 50vw, 100vw"
                      loading="lazy"
                    />
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </section>
    )}

    <!-- 05 Website -->
    {has('website') && (
      <section class="nv-section nv-wk-sec" id="website">
        <div class="nv-wrap nv-wk-site">
          <header class="nv-wk-head">
            <p class="nv-micro nv-wk-head__n">{num('website')}</p>
            <h2 class="nv-h2" data-reveal="clip">Property <span class="nv-accent-word">Website</span></h2>
            <p class="nv-body nv-wk-head__copy" data-reveal="up" style="--d:100ms">
              A dedicated site for the listing that puts every photo, the video, the floor plans
              and the 3D tour behind one clean link, ready for the sign rider, the brochure QR
              code and every social post.
            </p>
            <a
              href={listing.website!.url}
              class="nv-link nv-wk-site__link"
              target="_blank"
              rel="noopener"
              data-reveal="up"
              style="--d:160ms"
            >
              Visit {listing.website!.label} <span class="nv-arrow" aria-hidden="true">→</span>
            </a>
          </header>

          <a
            href={listing.website!.url}
            target="_blank"
            rel="noopener"
            class="nv-wk-browser nv-frame nv-frame--hover"
            data-reveal="up"
            aria-label={`Open ${listing.website!.label} in a new tab`}
          >
            <span class="nv-wk-browser__bar" aria-hidden="true">
              <span class="nv-wk-browser__dots"><i></i><i></i><i></i></span>
              <span class="nv-wk-browser__url">{listing.website!.label}</span>
            </span>
            <Image
              src={screenshot!}
              alt={`Homepage of ${listing.website!.label}`}
              widths={[800, 1400, 2160]}
              sizes="(min-width: 1100px) 60vw, 100vw"
              loading="lazy"
            />
          </a>
        </div>
      </section>
    )}

    <!-- 06 Floor plans -->
    {has('floor-plans') && (
      <section class="nv-section nv-wk-sec" id="floor-plans">
        <div class="nv-wrap">
          <header class="nv-wk-head nv-wk-head--row">
            <p class="nv-micro nv-wk-head__n">{num('floor-plans')}</p>
            <h2 class="nv-h2" data-reveal="clip">Floor Plans &amp; <span class="nv-accent-word">RMS</span></h2>
            <p class="nv-body nv-wk-head__copy" data-reveal="up" style="--d:100ms">
              RECA-standard RMS measurements and a scaled, labelled plan for every level, as
              images for the listing and as a PDF for buyers.
              {listing.floorplanPdf && (
                <a href={listing.floorplanPdf} class="nv-link" target="_blank" rel="noopener">
                  Open the PDF <span class="nv-arrow" aria-hidden="true">→</span>
                </a>
              )}
            </p>
          </header>
          <ul class="nv-wk-plans" data-lightbox-group style={`--cols:${Math.min(plans.length, 3)}`}>
            {
              plans.map((p, i) => (
                <li data-reveal="up" style={`--d:${i * 80}ms`}>
                  <a href={p.full} class="nv-wk-plan" data-lightbox data-caption={p.caption}>
                    <Image
                      src={p.src}
                      alt={`${p.caption} floor plan`}
                      widths={THUMB}
                      quality={THUMB_QUALITY}
                      sizes={`(min-width: 760px) ${Math.round(100 / Math.min(plans.length, 3))}vw, 100vw`}
                      loading="lazy"
                    />
                  </a>
                  <p class="nv-micro nv-wk-plan__label">{p.caption}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </section>
    )}

    <!-- 07 iGuide -->
    {has('iguide') && (
      <section class="nv-section nv-wk-sec" id="iguide">
        <div class="nv-wrap">
          <header class="nv-wk-head nv-wk-head--row">
            <p class="nv-micro nv-wk-head__n">{num('iguide')}</p>
            <h2 class="nv-h2" data-reveal="clip">iGuide <span class="nv-accent-word">3D Tour</span></h2>
            <p class="nv-body nv-wk-head__copy" data-reveal="up" style="--d:100ms">
              A walk-through buyers steer themselves, linked to the floor plan so they always know
              where they're standing. Try it below.
              <a href={listing.iguide!.url} class="nv-link" target="_blank" rel="noopener">
                Open full screen <span class="nv-arrow" aria-hidden="true">→</span>
              </a>
            </p>
          </header>
          <div class="nv-frame" data-reveal="up">
            <div class="nv-wk-ratio nv-wk-ratio--horiz">
              <iframe
                src={listing.iguide!.embed}
                title={`${listing.address} iGuide 3D virtual tour`}
                loading="lazy"
                allow="fullscreen; xr-spatial-tracking"
                allowfullscreen
              />
            </div>
          </div>
        </div>
      </section>
    )}

    <FinalCta
      eyebrow={listing.packageName}
      copy={`${kitSentence[0].toUpperCase()}${kitSentence.slice(1)} from one booking. The ${listing.packageName} starts at ${listing.packageFrom} + GST, priced by square footage.`}
      primary={{ label: 'Book a Shoot', href: BOOKING_URL }}
      secondary={{ label: 'See Pricing', href: '/pricing#packages' }}
    >
      <Fragment slot="title">
        Ready to Give Your Listing <span class="nv-accent-word">This Treatment</span>?
      </Fragment>
    </FinalCta>
  </main>

  <Footer />

  <Lightbox />

  <Motion />

  <style>
    /* ── Hero ── */
    .nv-wk-hero {
      position: relative;
      overflow: clip;
      display: flex;
      align-items: flex-end;
      min-height: min(92svh, 900px);
      padding-top: clamp(9rem, 16vw, 12rem);
      padding-bottom: clamp(3rem, 6vw, 5rem);
    }
    .nv-wk-hero__media {
      position: absolute;
      inset: -8% 0 -8% 0;
      z-index: -1;
      transform: translate3d(0, var(--py, 0px), 0);
    }
    .nv-wk-hero__media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 50% 55%;
      filter: saturate(1.02) contrast(1.04) brightness(0.8);
    }
    .nv-wk-hero__scrim {
      position: absolute;
      inset: 0;
      background:
        linear-gradient(to top, var(--color-brand-bg) 2%, rgb(10 14 23 / 0.55) 38%, rgb(10 14 23 / 0) 70%),
        linear-gradient(to right, rgb(10 14 23 / 0.5) 0%, transparent 55%);
    }
    .nv-wk-hero__title {
      margin: clamp(1rem, 2vw, 1.5rem) 0 0;
    }
    .nv-wk-hero__meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem 1.4rem;
      margin: clamp(1.5rem, 2.6vw, 2rem) 0 0;
      color: rgb(243 239 231 / 0.82);
    }
    .nv-wk-hero__meta span + span::before {
      content: '';
      display: inline-block;
      width: 1.4rem;
      height: 1px;
      margin-right: 1.4rem;
      vertical-align: middle;
      background: var(--color-brand-accent);
    }
    .nv-wk-hero__meta a {
      color: var(--color-brand-text);
      text-decoration: underline;
      text-decoration-color: var(--color-brand-accent);
      text-underline-offset: 0.3em;
    }

    /* ── Intro + kit list ── */
    .nv-wk-intro__grid {
      display: grid;
      gap: clamp(2.5rem, 6vw, 6rem);
    }
    @media (min-width: 960px) {
      .nv-wk-intro__grid {
        grid-template-columns: 1.1fr 1fr;
        align-items: start;
      }
    }
    .nv-wk-intro__copy {
      max-width: 56ch;
      margin: 1.5rem 0 0;
    }
    .nv-wk-kit {
      margin: 0;
      padding: 0;
      list-style: none;
      border-top: 1px solid var(--nv-hairline-strong);
    }
    .nv-wk-kit li {
      border-bottom: 1px solid var(--nv-hairline);
    }
    .nv-wk-kit__row {
      display: grid;
      grid-template-columns: 2.5rem 1fr auto;
      align-items: baseline;
      gap: 1rem;
      padding: 1.05rem 0.25rem;
      color: var(--color-brand-text);
      text-decoration: none;
      transition: color 0.3s ease, padding 0.4s var(--nv-ease);
    }
    .nv-wk-kit__row:hover {
      padding-left: 0.75rem;
      color: var(--color-brand-accent);
    }
    .nv-wk-kit__n {
      color: var(--color-brand-accent);
    }
    .nv-wk-kit__name {
      font-family: var(--font-heading);
      font-weight: 350;
      font-size: clamp(1.15rem, 1.6vw, 1.4rem);
      letter-spacing: -0.015em;
    }
    @media (max-width: 420px) {
      .nv-wk-kit__row {
        grid-template-columns: 2rem 1fr;
      }
      .nv-wk-kit__note {
        grid-column: 2;
      }
    }

    /* ── Section heads ── */
    .nv-wk-sec {
      border-top: 1px solid var(--nv-hairline);
      scroll-margin-top: 4rem;
    }
    .nv-wk-head {
      margin-bottom: clamp(2rem, 4vw, 3.25rem);
    }
    .nv-wk-head__n {
      margin: 0 0 1rem;
      color: var(--color-brand-accent);
    }
    .nv-wk-head__copy {
      max-width: 58ch;
      margin: 1.25rem 0 0;
    }
    .nv-wk-head__copy .nv-link {
      margin-left: 0.35rem;
      white-space: nowrap;
    }
    @media (min-width: 960px) {
      .nv-wk-head--row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        column-gap: clamp(2rem, 5vw, 5rem);
        align-items: end;
      }
      .nv-wk-head--row .nv-wk-head__n {
        grid-column: 1 / -1;
      }
      .nv-wk-head--row .nv-wk-head__copy {
        margin: 0;
      }
    }

    /* ── Video frames ── */
    .nv-wk-ratio {
      position: relative;
      overflow: hidden;
      background: var(--color-brand-surface);
    }
    .nv-wk-ratio--horiz {
      aspect-ratio: 16 / 9;
    }
    .nv-wk-ratio--vert {
      aspect-ratio: 9 / 16;
    }
    .nv-wk-ratio iframe {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border: 0;
    }
    .nv-wk-reel {
      display: grid;
      gap: clamp(2rem, 5vw, 5rem);
    }
    .nv-wk-stat {
      display: grid;
      gap: 0.5rem;
      margin: clamp(1.75rem, 3vw, 2.5rem) 0 0;
      padding-left: 1.25rem;
      border-left: 2px solid var(--color-brand-accent);
    }
    .nv-wk-stat__value {
      font-family: var(--font-heading);
      font-weight: 300;
      font-size: clamp(2.5rem, 5vw, 3.75rem);
      line-height: 1;
      letter-spacing: -0.03em;
      color: var(--color-brand-accent);
    }
    .nv-wk-stat__label {
      color: var(--color-brand-text);
    }
    .nv-wk-reel__video {
      width: 100%;
      max-width: 400px;
      margin-inline: auto;
    }
    @media (min-width: 860px) {
      .nv-wk-reel {
        grid-template-columns: 1fr minmax(300px, 400px);
        align-items: center;
      }
      .nv-wk-reel .nv-wk-head {
        margin: 0;
      }
    }

    /* ── Photo grids ── */
    .nv-wk-grid {
